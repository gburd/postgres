#!/usr/bin/env python3

#
# Wrapper around the Lime parser generator that:
# - redirects Lime's output files (.c, .h, .out) into a private build
#   directory, analogous to pgflex/pgbison so concurrent invocations
#   don't race on generator-side scratch files
# - shapes the command line into the (input, output-dir) form Lime
#   expects (`lime -d <outdir> input.lime`)
# - moves the generated files from <outdir>/<basename>.{c,h} to the
#   meson-declared OUTPUT paths
# - treats Lime's `.out` report as a build artefact worth keeping
#   (mirrored from <outdir>/<basename>.out into <privatedir>)
#
# Lime itself is a single-binary, zero-dep tool.  The wrapper exists
# so meson's `custom_target` contract (named outputs, @INPUT@ /
# @OUTPUT0@ / @OUTPUT1@ placeholders, concurrency-safe private
# directories) maps cleanly onto Lime's `-d <dir> <input>` CLI.
#
# See src/tools/pgflex for the sibling wrapper around flex.
#

import argparse
import os
import shutil
import subprocess
import sys
from os.path import abspath, basename, dirname, join, splitext

parser = argparse.ArgumentParser()

parser.add_argument('--lime', type=abspath, required=True,
                    help='path to the lime binary')
parser.add_argument('--builddir', type=abspath, required=True,
                    help='meson top-level build directory')
parser.add_argument('--srcdir', type=abspath, required=True,
                    help='meson top-level source directory')
parser.add_argument('--privatedir', type=abspath, required=True,
                    help='private directory for this target')

parser.add_argument('-i', dest='input_file', type=abspath, required=True,
                    help='grammar file (.lime)')
parser.add_argument('-c', dest='output_c', type=abspath, required=True,
                    help='generated .c output path')
parser.add_argument('-H', dest='output_h', type=abspath, required=True,
                    help='generated .h output path')

parser.add_argument('--aot', action='store_true',
                    help='also produce <basename>_aot.c via lime -j')
parser.add_argument('--aot-output', dest='output_aot', type=abspath,
                    default=None,
                    help='destination for the generated _aot.c (required '
                    'when --aot is set)')

parser.add_argument('--snapshot', action='store_true',
                    help='also produce <basename>_snapshot.c via lime -n '
                    '(runtime ParserSnapshot builder + embedded grammar '
                    'source, for in-process grammar extension)')
parser.add_argument('--snapshot-output', dest='output_snapshot',
                    type=abspath, default=None,
                    help='destination for the generated _snapshot.c '
                    '(required when --snapshot is set)')
parser.add_argument('--host-reduce', action='store_true',
                    help='with --snapshot, pass `lime --host-reduce` so the '
                    'generated <Name>HostReduce wrapper runs the base '
                    'grammar reduce actions over a runtime snapshot '
                    '(threads the extra-argument, e.g. yyscanner, from the '
                    'host_reduce user pointer); requires Lime v1.6.1+')

parser.add_argument('lime_flags', nargs='*',
                    help='flags passed on to lime (e.g. -s, -T template)')

args = parser.parse_args()

# Private directory acts as Lime's -d output directory.  Lime writes
# <basename>.c, <basename>.h, and <basename>.out there.  We create
# the directory up front; ninja sets CWD to the build root, so any
# relative paths lime might emit are rooted in the build tree.
os.makedirs(args.privatedir, exist_ok=True)

command = [args.lime, '-d' + args.privatedir]
if args.aot:
    command += ['-j']
if args.snapshot:
    command += ['-n']
if args.host_reduce:
    command += ['--host-reduce']
command += args.lime_flags
command += [args.input_file]

sp = subprocess.run(command)
if sp.returncode != 0:
    sys.exit(sp.returncode)

# Lime names its outputs after the input file's basename.  Move them
# into the meson-declared OUTPUT0/OUTPUT1 paths.
stem = splitext(basename(args.input_file))[0]
gen_c = join(args.privatedir, stem + '.c')
gen_h = join(args.privatedir, stem + '.h')

if not os.path.isfile(gen_c):
    sys.exit(f'lime did not produce expected output: {gen_c}')
if not os.path.isfile(gen_h):
    sys.exit(f'lime did not produce expected output: {gen_h}')

# Performance fix (host-reduce hot path): the generated <Name>HostReduce
# wrapper zeroes an ENTIRE stack yyParser on every reduce with
#   memset(&yyp, 0, sizeof yyp);
# but yyParser embeds yystk0[YYSTACKDEPTH] -- the parser's whole initial
# stack (~1.6 KB for the SQL grammar).  The per-rule reduce action bodies
# only ever read the small header fields (the %extra_argument slot and the
# action-time lookahead state); they never touch the embedded stack (only
# the driver's base_yyparse/yy_shift/yy_reduce do).  Profiling the push
# path shows this single memset at ~63% of total parse time.  yystk0 is the
# last struct member, so zeroing only the bytes before it clears every
# field an action reads while skipping the large stack-array zero.  Rewrite
# the emitted line in place; error out loudly if the pinned generator ever
# stops emitting it verbatim, so a Lime upgrade cannot silently drop the fix.
_HR_OLD = '  memset(&yyp, 0, sizeof yyp);\n'
_HR_NEW = ('  /* host-reduce hot path: zero only the header fields the reduce\n'
           '  ** actions read, NOT the embedded yystk0[YYSTACKDEPTH] stack\n'
           '  ** (which no action touches).  yystk0 is the last member, so\n'
           '  ** the byte span before it is exactly the header.  This drops\n'
           '  ** the ~1.6 KB per-reduce memset that dominated push-parse. */\n'
           '  memset(&yyp, 0, (size_t)((char *)&yyp.yystk0 - (char *)&yyp));\n')
# Second hot memset: the wrapper zeroes the whole yystk[YYNRHS_MAX+2]
# scratch (23 entries) on every reduce, but only touches yystk[0..nrhs]
# (the RHS slots plus the empty-rule LHS slot); the higher entries are
# never read.  Zero just the slots in play -- nrhs averages 1-3, so this
# is a few slots instead of the full 23-entry array.
_YS_OLD = '  memset(yystk, 0, sizeof(yystk));\n'
_YS_NEW = ('  /* host-reduce hot path: zero only the slots actually used\n'
           '  ** (yystk[0..nrhs]); the rest of the scratch is never read. */\n'
           '  memset(yystk, 0, sizeof(yystk[0]) * (size_t)(nrhs + 1));\n')
with open(gen_c, 'r') as f:
    _c_text = f.read()
if _HR_OLD in _c_text:
    _c_text = _c_text.replace(_HR_OLD, _HR_NEW, 1)
    _c_text = _c_text.replace(_YS_OLD, _YS_NEW, 1)
    with open(gen_c, 'w') as f:
        f.write(_c_text)
elif 'HostReduce' in _c_text and '&yyp.yystk0' not in _c_text:
    sys.exit('pglime: expected host-reduce memset line not found in '
             f'{gen_c}; the Lime host-reduce wrapper changed -- update the '
             'pglime post-process (host-reduce hot-path fix would be lost).')

os.makedirs(dirname(args.output_c), exist_ok=True)
os.makedirs(dirname(args.output_h), exist_ok=True)
shutil.move(gen_c, args.output_c)
shutil.move(gen_h, args.output_h)

if args.aot:
    if not args.output_aot:
        sys.exit('--aot requires --aot-output')
    gen_aot = join(args.privatedir, stem + '_aot.c')
    if not os.path.isfile(gen_aot):
        sys.exit(f'lime -j did not produce expected output: {gen_aot}')
    os.makedirs(dirname(args.output_aot), exist_ok=True)
    shutil.move(gen_aot, args.output_aot)

if args.snapshot:
    if not args.output_snapshot:
        sys.exit('--snapshot requires --snapshot-output')
    gen_snapshot = join(args.privatedir, stem + '_snapshot.c')
    if not os.path.isfile(gen_snapshot):
        sys.exit(f'lime -n did not produce expected output: {gen_snapshot}')
    os.makedirs(dirname(args.output_snapshot), exist_ok=True)
    shutil.move(gen_snapshot, args.output_snapshot)

sys.exit(0)

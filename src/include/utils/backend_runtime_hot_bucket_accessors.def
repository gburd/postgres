/*
 * Inline public current-bucket accessor aliases.
 *
 * Each alias first consults the generated current-work hot bucket pointer and
 * falls back to the existing out-of-line accessor when no current-work bucket
 * is installed.  Keep this list explicit where historical accessor names do
 * not mechanically match bucket names.
 */

#define PgCurrentBackendMemoryManagerState() \
	PG_RUNTIME_FAST_BUCKET_ACCESSOR(CurrentPgBackendMemoryManagerRuntimeState, \
								   PgCurrentBackendMemoryManagerState)

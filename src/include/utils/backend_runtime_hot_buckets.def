/*
 * Hot current-work runtime bucket cache definitions.
 *
 * Each row names a thread-local compatibility cache pointer derived from the
 * active backend or execution object.  These are not ownership roots; they are
 * rebound with the current runtime work and cleared whenever current runtime
 * work is cleared.
 *
 * Arguments:
 *   variable name, pointed-to type, current work variable, field name
 */

PG_RUNTIME_HOT_BUCKET(CurrentPgBackendBufferRuntimeState,
					  PgBackendBufferState,
					  backend,
					  buffers)

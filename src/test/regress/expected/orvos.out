create table t_zedtoast(c1 int, t text) USING orvos;
insert into t_zedtoast select i, repeat('x', 10000) from generate_series(1, 10) i;
select c1, length(t) from t_zedtoast;
 c1 | length 
----+--------
  1 |  10000
  2 |  10000
  3 |  10000
  4 |  10000
  5 |  10000
  6 |  10000
  7 |  10000
  8 |  10000
  9 |  10000
 10 |  10000
(10 rows)


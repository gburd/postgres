  6 |   7 |  8
  7 |   8 |  9
  9 |  10 | 11
 10 |  11 | 12
 31 |  32 | 33
 32 |  33 | 34
 33 |  34 | 35
 34 |  35 | 36
 35 |  36 | 37
  8 | 100 | 10
(11 rows)

--
-- Test page deletion, by deleting a bigger range of values
--
insert into t_orvos select i,i+1,i+2 from generate_series(10000, 15000)i;
delete from t_orvos where c1 >= 10000;
--
-- Test VACUUM
--
vacuum t_orvos;
select * from t_orvos;
 c1 | c2  | c3 
----+-----+----
  5 |   6 |  7
  6 |   7 |  8
  7 |   8 |  9
  9 |  10 | 11
 10 |  11 | 12
 31 |  32 | 33
 32 |  33 | 34
 33 |  34 | 35
 34 |  35 | 36
 35 |  36 | 37
  8 | 100 | 10
(11 rows)

--
-- Test toasting

SELECT COUNT(*) FROM heap_perf_test WHERE id IN (
    SELECT i * 8 FROM generate_series(1, 5000) i
);
 count 
-------
     0
(1 row)

SELECT COUNT(*) FROM recno_perf_test WHERE id IN (
    SELECT i * 8 FROM generate_series(1, 5000) i
);
 count 

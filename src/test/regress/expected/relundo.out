CREATE TABLE relundo_drop_test (id int) USING test_relundo_am;
ERROR:  access method "test_relundo_am" does not exist
INSERT INTO relundo_drop_test VALUES (1);
ERROR:  relation "relundo_drop_test" does not exist
LINE 1: INSERT INTO relundo_drop_test VALUES (1);
                    ^
-- Verify UNDO chain exists
SELECT count(*) AS undo_record_count FROM test_relundo_dump_chain('relundo_drop_test');
ERROR:  function test_relundo_dump_chain(unknown) does not exist
LINE 1: SELECT count(*) AS undo_record_count FROM test_relundo_dump_...
                                                  ^
DETAIL:  There is no function of that name.
-- Drop should succeed and clean up
DROP TABLE relundo_drop_test;
ERROR:  table "relundo_drop_test" does not exist

  SELECT count(b) FROM bark_pscan WHERE a BETWEEN 1000 AND 60000;
                                QUERY PLAN                                
--------------------------------------------------------------------------
 Finalize Aggregate
   ->  Gather
         Workers Planned: 4
         ->  Partial Aggregate
               ->  Parallel Index Scan using bark_pscan_idx on bark_pscan
                     Index Cond: ((a >= 1000) AND (a <= 60000))

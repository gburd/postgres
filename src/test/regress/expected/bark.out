CREATE TABLE bark_pfx (id int, k text);
INSERT INTO bark_pfx SELECT g, repeat('P', 5000) || lpad(g::text, 8, '0')
  FROM generate_series(1, 50) g;
CREATE INDEX bark_pfx_idx ON bark_pfx USING bark (k);

RESET enable_indexonlyscan;
RESET enable_indexscan;
RESET enable_seqscan;
DROP FUNCTION bark_rowcmp_check(text), bark_rowcmp_run(text, text),
  bark_rowcmp_pages(text);
DROP TABLE bark_rowcmp;

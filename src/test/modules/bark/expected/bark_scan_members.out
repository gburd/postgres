-- Every other row of one POSTING entry dead: each kill starts a run of its
-- own, more than the scan keeps (the rest are dropped, which only loses
-- hints), and the entry is not marked, since its live rows were not killed.
CREATE TEMP TABLE sm_alt (k int, v int) WITH (autovacuum_enabled = off);
INSERT INTO sm_alt SELECT 1, g FROM generate_series(1, 3000) g;
CREATE INDEX sm_alt_k ON sm_alt USING bark (k);
DELETE FROM sm_alt WHERE v % 2 = 0;
SELECT count(*), sum(v) FROM sm_alt WHERE k = 1;

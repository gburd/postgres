-- Parallel index scans over the same entries.  Temporary tables are not
-- parallel safe, so a copy.
CREATE TABLE sm_par (k int, v int) WITH (autovacuum_enabled = off, parallel_workers = 2);
INSERT INTO sm_par SELECT k, v FROM sm ORDER BY ctid;
CREATE INDEX sm_par_k ON sm_par USING bark (k);
VACUUM ANALYZE sm_par;
SET min_parallel_table_scan_size = 0;
SET min_parallel_index_scan_size = 0;
SET parallel_setup_cost = 0;
SET parallel_tuple_cost = 0;
SET max_parallel_workers_per_gather = 2;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
EXPLAIN (COSTS OFF) SELECT count(*), sum(v) FROM sm_par WHERE k <= 6;

--
-- Scans that return a LIST or POSTING entry's rows one at a time.  A leaf
-- read copies one item per matching entry, and bark_gettuple decodes an
-- entry's members only when it reaches the entry (README, "Scans"), so a
-- LIMIT stops inside the first entry, an OFFSET resumes in the middle of
-- one, a backward scan or a scroll cursor turns around inside one, and a
-- mark can sit on any member.  Each result is compared with a sequential
-- scan.  Shapes, all on one table: POSTING entries (keys whose rows are
-- together on the heap), coded LISTs (rows a few apart), plain LISTs (two
-- rows far apart, which code no shorter), and SINGLEs.
--
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS pageinspect;
CREATE EXTENSION IF NOT EXISTS amcheck;
RESET client_min_messages;
-- Index result and seqscan result of query q, as md5s of their rows in the
-- query's own order.
CREATE FUNCTION sm_cmp(q text, OUT idx text, OUT seq text, OUT same bool)
LANGUAGE plpgsql AS $$
BEGIN
  PERFORM set_config('enable_seqscan', 'off', true);
  PERFORM set_config('enable_bitmapscan', 'off', true);
  EXECUTE 'SELECT md5(coalesce(string_agg(x::text, '','' ORDER BY n), '''')) '
    'FROM (SELECT x, row_number() OVER () n FROM (' || q || ') x) y' INTO idx;
  PERFORM set_config('enable_seqscan', 'on', true);
  PERFORM set_config('enable_indexscan', 'off', true);
  PERFORM set_config('enable_indexonlyscan', 'off', true);
  EXECUTE 'SELECT md5(coalesce(string_agg(x::text, '','' ORDER BY n), '''')) '
    'FROM (SELECT x, row_number() OVER () n FROM (' || q || ') x) y' INTO seq;
  PERFORM set_config('enable_indexscan', 'on', true);
  PERFORM set_config('enable_indexonlyscan', 'on', true);
  same := idx = seq;
END $$;
-- The plan's scan node for q, with seqscans and bitmap scans off.
CREATE FUNCTION sm_plan(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE l text; r text := '';
BEGIN
  PERFORM set_config('enable_seqscan', 'off', true);
  PERFORM set_config('enable_bitmapscan', 'off', true);
  FOR l IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP
    IF l ~ 'Scan' THEN r := r || trim(regexp_replace(l, ' on .*| using .*', '')) || ';'; END IF;
  END LOOP;
  PERFORM set_config('enable_seqscan', 'on', true);
  PERFORM set_config('enable_bitmapscan', 'on', true);
  RETURN r;
END $$;
-- Keys 1-3: 300 rows each, inserted together.  Key 4: 3000 rows together.
-- Keys 5-6: 100 rows each, one every 40 heap rows.  Keys 7-1206: one row
-- each.  Keys 2000-2009: two rows each, one inserted first and one last.
-- v orders the rows of a key by insertion, which is heap TID order, the
-- index's order within a key.
CREATE TEMP TABLE sm (k int, v int) WITH (autovacuum_enabled = off);
INSERT INTO sm SELECT 2000 + g, 30000 + g FROM generate_series(0, 9) g;
INSERT INTO sm SELECT 1 + (g - 1) / 300, g FROM generate_series(1, 900) g;
INSERT INTO sm SELECT 4, 1000 + g FROM generate_series(1, 3000) g;
INSERT INTO sm SELECT CASE WHEN g % 40 = 0 THEN 5 + (g / 40) % 2 ELSE 1000000 + g END,
    10000 + g FROM generate_series(1, 8000) g;
DELETE FROM sm WHERE k >= 1000000;
INSERT INTO sm SELECT 7 + g, 20000 + g FROM generate_series(0, 1199) g;
INSERT INTO sm SELECT 2000 + g, 31000 + g FROM generate_series(0, 9) g;
CREATE INDEX sm_k ON sm USING bark (k);
VACUUM ANALYZE sm;
-- The leaf entries: key, shape (a coded LIST is shorter than the plain
-- form), TIDs, and whether the entry is LP_DEAD.
CREATE FUNCTION sm_entries(OUT k int, OUT shape text, OUT ntids int, OUT dead bool)
RETURNS SETOF record LANGUAGE sql AS $$
  SELECT CASE WHEN i.shape <> 'PIVOT' THEN
           (SELECT s.k FROM sm s WHERE s.ctid = coalesce(i.htid, i.tids[1])) END,
         CASE WHEN i.shape = 'LIST' AND i.itemlen < (SELECT ((8 + 4 + max_data_alignment - 1) / max_data_alignment) * max_data_alignment FROM pg_control_init()) + 6 * i.ntids
              THEN 'LIST coded' ELSE i.shape END, i.ntids, h.lp_flags = 3
    FROM generate_series(1, pg_relation_size('sm_k') / current_setting('block_size')::int - 1) b,
         LATERAL bark_page_stats('sm_k', b) p,
         LATERAL bark_page_items('sm_k', b) i
         JOIN heap_page_items(get_raw_page('sm_k', b::int)) h ON h.lp = i.itemoffset
   WHERE p.type = 'leaf' AND i.shape <> 'PIVOT'
$$;
SELECT CASE WHEN k BETWEEN 7 AND 1206 THEN '7-1206'
            WHEN k >= 2000 THEN '2000-2009' ELSE k::text END AS k, shape,
       count(*) AS entries, sum(ntids) AS tids
  FROM sm_entries() GROUP BY 1, 2 ORDER BY 1, 2;
     k     |   shape    | entries | tids 
-----------+------------+---------+------
 1         | POSTING    |       1 |  300
 2         | POSTING    |       1 |  300
 2000-2009 | LIST       |      10 |   20
 3         | LIST coded |       3 |  300
 4         | POSTING    |       1 | 3000
 5         | LIST coded |       1 |  100
 6         | LIST coded |       1 |  100
 7-1206    | SINGLE     |    1200 | 1200
(8 rows)


----------------------------------------------------------------
 Aggregate
   ->  Bitmap Heap Scan on sm
         Recheck Cond: (((k >= 2) AND (k <= 6)) OR (k >= 2000))
         ->  BitmapOr
               ->  Bitmap Index Scan on sm_k
                     Index Cond: ((k >= 2) AND (k <= 6))
               ->  Bitmap Index Scan on sm_k
                     Index Cond: (k >= 2000)

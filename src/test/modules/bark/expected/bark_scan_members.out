-- Bitmap scans take each entry's members as a batch.
SET enable_seqscan = off;
SET enable_indexscan = off;
SET enable_indexonlyscan = off;
EXPLAIN (COSTS OFF) SELECT count(*), sum(v) FROM sm WHERE k BETWEEN 2 AND 6 OR k >= 2000;

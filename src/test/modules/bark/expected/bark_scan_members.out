DROP TABLE sm_par;
-- Kills: rows that a scan finds dead mark their entry LP_DEAD when the
-- scan leaves the page, but only when it killed every member of the entry.
-- Only equality scans read here, so that no planner probe of the index's
-- ends (get_actual_variable_range) kills anything.  Key 1 (POSTING) and key
-- 5 (coded LIST) die whole; key 2 keeps one row in the middle, so its two
-- runs of kills do not cover it.  Key 4 (POSTING) keeps its middle row: a
-- LIMIT 1 stops on it after killing the members before it, and marks
-- nothing; once that row dies too, a LIMIT 1 reads the whole entry, killing
-- all of it.  Key 2003 (plain LIST) dies, read backward.
DELETE FROM sm WHERE k IN (1, 5, 2003);
DELETE FROM sm WHERE k = 2 AND v <> 450;
DELETE FROM sm WHERE k = 4 AND v <> 2500;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SET enable_indexonlyscan = off;

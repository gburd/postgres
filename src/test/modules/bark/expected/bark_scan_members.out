-- The leaf a scan stopped on splits before the scan goes on.  The scan
-- resumes from its copy of the page, in the middle of an entry, and then
-- steps to the right sibling it saved, past the pages the splits made,
-- whose entries were all in the copy.  The cursor's snapshot does not see
-- the new rows, scattered duplicates of the SINGLE keys on the leaf.
CREATE TEMP TABLE sm_want3 AS
  SELECT count(*) AS n, sum(v) AS s FROM sm WHERE k BETWEEN 3 AND 1206;
CREATE FUNCTION sm_drain(OUT n bigint, OUT s bigint) LANGUAGE plpgsql AS $$
DECLARE cur refcursor := 'c'; r record;
BEGIN
  n := 0; s := 0;
  LOOP
    FETCH cur INTO r;
    EXIT WHEN NOT FOUND;
    n := n + 1; s := s + r.v;
  END LOOP;
END $$;
CREATE TEMP TABLE sm_leaves AS
  SELECT count(*) AS n FROM generate_series(1, pg_relation_size('sm_k') / current_setting('block_size')::int - 1) b,
         LATERAL bark_page_stats('sm_k', b) p WHERE p.type = 'leaf';
BEGIN;
SET LOCAL enable_seqscan = off;
SET LOCAL enable_bitmapscan = off;
DECLARE c NO SCROLL CURSOR FOR SELECT k, v FROM sm WHERE k BETWEEN 3 AND 1206 ORDER BY k;
MOVE 150 IN c;
INSERT INTO sm SELECT 7 + g % 200, 50000 + g FROM generate_series(1, 20000) g;
SELECT count(*) > (SELECT n FROM sm_leaves) AS split
  FROM generate_series(1, pg_relation_size('sm_k') / current_setting('block_size')::int - 1) b,
       LATERAL bark_page_stats('sm_k', b) p WHERE p.type = 'leaf';
 split 
-------
 t
(1 row)

SELECT d.n + 150 = w.n AS same_count, d.s FROM sm_drain() d, sm_want3 w;
 same_count |    s     
------------+----------
 t          | 26243225
(1 row)

COMMIT;

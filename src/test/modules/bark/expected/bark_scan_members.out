RESET enable_sort;
-- Mark and restore inside entries: a merge join whose inner side is an
-- index scan of sm, rescanned over each run of equal keys of the outer
-- side, with the runs' marks on members of LIST and POSTING entries.
CREATE TEMP TABLE sm_outer (k int, w int);
INSERT INTO sm_outer SELECT k, w FROM generate_series(1, 7) k, generate_series(1, 3) w;
ANALYZE sm_outer;
SET enable_hashjoin = off;
SET enable_nestloop = off;
SET enable_material = off;
SELECT sm_plan('SELECT * FROM sm_outer o JOIN sm s ON s.k = o.k');
           sm_plan            
------------------------------
 ->  Index Scan;->  Seq Scan;

-- A scroll cursor turns around inside an entry, and jumps into one.  Each
-- FETCH is compared with the same position of the seqscan's ordered rows.
CREATE TEMP TABLE sm_want AS
  SELECT row_number() OVER (ORDER BY k, v) AS n, k, v FROM sm WHERE k BETWEEN 3 AND 5;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SET enable_sort = off;
BEGIN;
DECLARE c SCROLL CURSOR FOR SELECT k, v FROM sm WHERE k BETWEEN 3 AND 5 ORDER BY k;
CREATE TEMP TABLE sm_got (step int, k int, v int);
CREATE FUNCTION sm_fetch(step int, how text) RETURNS void LANGUAGE plpgsql AS $$
DECLARE r record;
BEGIN
  EXECUTE 'FETCH ' || how || ' FROM c' INTO r;
  INSERT INTO sm_got VALUES (step, r.k, r.v);
END $$;

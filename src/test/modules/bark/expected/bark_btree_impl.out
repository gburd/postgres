DETAIL:  Key (ref)=(99999) is not present in table "uq".
DELETE FROM uq WHERE v = 3;
ERROR:  update or delete on table "uq" violates foreign key constraint "fk_ref_fkey" on table "fk"
DETAIL:  Key (v)=(3) is still referenced from table "fk".
UPDATE uq SET v = v + 10000 WHERE v = 4;
ERROR:  update or delete on table "uq" violates foreign key constraint "fk_ref_fkey" on table "fk"
DETAIL:  Key (v)=(4) is still referenced from table "fk".

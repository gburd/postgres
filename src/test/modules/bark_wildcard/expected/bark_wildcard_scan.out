 doc #= '["", 5]'   | 3:3:26fc36d968a4e9544fced8f3d3b9d53c | 3:3:26fc36d968a4e9544fced8f3d3b9d53c | 3:3:26fc36d968a4e9544fced8f3d3b9d53c
 doc #= '["a.", 5]' | 1:1:e4da3b7fbbce2345d7772b0674a318d5 | 1:1:e4da3b7fbbce2345d7772b0674a318d5 | 1:1:e4da3b7fbbce2345d7772b0674a318d5
 doc #= '["s", 5]'  | 3:3:55b84a9d317184fe61224bfb4a060fb0 | 3:3:55b84a9d317184fe61224bfb4a060fb0 | 3:3:55b84a9d317184fe61224bfb4a060fb0

-- b.c on wc_exc (every row the scan reads is rechecked), and the compound
-- index with a range on its first column.
SET enable_seqscan = off;
EXPLAIN (COSTS OFF) SELECT id FROM wc_exc WHERE doc #= '["b.c", 5]';

-- Selectivity of the wildcard operators (bark_wildcard_sel), read from the
-- index's separators and leaves (bark_estimate_qual_selectivity).
--
-- wc_sel has 100000 documents: p1 is true in 90% of them, p2 in 0.1%, and
-- p3 is a number below 10 in 99% and a large one in 1%.  Each also has a
-- distinct id, so the index is three levels tall.  An estimate counts when
-- it is within 3x of the actual count; plans show the scan it picks.
CREATE EXTENSION bark_wildcard;
SET max_parallel_workers_per_gather = 0;
CREATE TABLE wc_sel (id int, doc jsonb) WITH (autovacuum_enabled = off);
INSERT INTO wc_sel
  SELECT g, jsonb_strip_nulls(jsonb_build_object(
              'id', g,
              'p1', CASE WHEN g % 10 <> 0 THEN true END,
              'p2', CASE WHEN g % 1000 = 0 THEN true END,
              'p3', CASE WHEN g % 100 = 0 THEN g ELSE g % 10 END))
    FROM generate_series(1, 100000) g;
CREATE INDEX wc_sel_doc ON wc_sel USING bark (doc bark_jsonb_wildcard_ops);
ANALYZE wc_sel;
-- The planner's row estimate for a qual on a table, and the actual count.
CREATE FUNCTION wc_est(tab text, q text, OUT est float8, OUT act bigint)
LANGUAGE plpgsql AS $$
DECLARE
  plan json;
BEGIN
  EXECUTE format('EXPLAIN (FORMAT JSON) SELECT * FROM %I WHERE %s', tab, q) INTO plan;
  est := (plan -> 0 -> 'Plan' ->> 'Plan Rows')::float8;
  EXECUTE format('SELECT count(*) FROM %I WHERE %s', tab, q) INTO act;
END $$;
CREATE TABLE wc_sel_q (n int, q text);
INSERT INTO wc_sel_q VALUES
  (1, 'doc #= ''["p1", true]'''),
  (2, 'doc #= ''["p2", true]'''),
  (3, 'doc #? ''p1'''),
  (4, 'doc #? ''p2'''),
  (5, 'doc #< ''["p3", 10]'''),
  (6, 'doc #> ''["p3", 1000]'''),
  (7, 'doc #>= ''["id", 50001]''');
SELECT n, q, act, est BETWEEN act / 3.0 AND act * 3.0 AS within_3x
  FROM wc_sel_q, LATERAL wc_est('wc_sel', q) ORDER BY n;
 n |            q            |  act  | within_3x 
---+-------------------------+-------+-----------
 1 | doc #= '["p1", true]'   | 90000 | t
 2 | doc #= '["p2", true]'   |   100 | t
 3 | doc #? 'p1'             | 90000 | t
 4 | doc #? 'p2'             |   100 | t
 5 | doc #< '["p3", 10]'     | 99000 | t
 6 | doc #> '["p3", 1000]'   |   990 | t
 7 | doc #>= '["id", 50001]' | 50000 | t
(7 rows)

-- p1 is in most documents, p2 in few: a seqscan for p1, the index for p2.
-- (Before the index read its leaf densities, the wide ranges, #? 'p1' and
-- the 99% head of p3, whose keys share POSTING entries, were estimated
-- from the separators alone and missed by about 10x.)
SELECT a.est = b.est AS same_estimate
  FROM wc_est('wc_sel', 'doc #= ''["p1", true]''') a,
       wc_est('wc_sel', 'doc #= ''["p2", true]''') b;
 same_estimate 
---------------
 f
(1 row)

EXPLAIN (COSTS OFF) SELECT * FROM wc_sel WHERE doc #= '["p1", true]';
                QUERY PLAN                
------------------------------------------
 Seq Scan on wc_sel
   Filter: (doc #= '["p1", true]'::jsonb)
(2 rows)

EXPLAIN (COSTS OFF) SELECT * FROM wc_sel WHERE doc #= '["p2", true]';
                     QUERY PLAN                     
----------------------------------------------------
 Bitmap Heap Scan on wc_sel
   Recheck Cond: (doc #= '["p2", true]'::jsonb)
   ->  Bitmap Index Scan on wc_sel_doc
         Index Cond: (doc #= '["p2", true]'::jsonb)
(4 rows)

EXPLAIN (COSTS OFF) SELECT * FROM wc_sel WHERE doc #? 'p1';
          QUERY PLAN           
-------------------------------
 Seq Scan on wc_sel
   Filter: (doc #? 'p1'::text)
(2 rows)

EXPLAIN (COSTS OFF) SELECT * FROM wc_sel WHERE doc #? 'p2';
               QUERY PLAN                
-----------------------------------------
 Bitmap Heap Scan on wc_sel
   Recheck Cond: (doc #? 'p2'::text)
   ->  Bitmap Index Scan on wc_sel_doc
         Index Cond: (doc #? 'p2'::text)
(4 rows)

-- More quals, each against its count: a value past every sample key, a
-- path with no keys (an empty point, estimated at one row), a narrow
-- range that runs past the four leaves an exact count reads
-- (extrapolated), and an OR, which the planner estimates per arm.
INSERT INTO wc_sel_q VALUES
  (8, 'doc #> ''["p3", 99999]'''),
  (9, 'doc #= ''["zz", 1]'''),
  (10, 'doc #>= ''["p3", 2]'' AND doc #<= ''["p3", 3]'''),
  (11, 'doc #= ''["p2", true]'' OR doc #= ''["p3", 7]''');
SELECT n, q, act, est BETWEEN act / 3.0 AND act * 3.0 AS within_3x
  FROM wc_sel_q, LATERAL wc_est('wc_sel', q) WHERE n > 7 ORDER BY n;
 n  |                      q                      |  act  | within_3x 
----+---------------------------------------------+-------+-----------
  8 | doc #> '["p3", 99999]'                      |     1 | t
  9 | doc #= '["zz", 1]'                          |     0 | f
 10 | doc #>= '["p3", 2]' AND doc #<= '["p3", 3]' | 20000 | t
 11 | doc #= '["p2", true]' OR doc #= '["p3", 7]' | 10100 | t
(4 rows)

-- Quals the index does not answer keep the default: a constant that is
-- NULL, a non-constant argument, the operator with the column on the
-- right, and a path the include projection drops (procedure 8 then asks
-- for the NULL entries, which hold more than the matches).
SELECT (wc_est('wc_sel', 'doc #= NULL')).est;
 est 
-----
   0
(1 row)

SELECT (wc_est('wc_sel', 'doc #= jsonb_build_array(''p2'', id > 0)')).est;
 est  
------
 1000
(1 row)

SELECT (wc_est('wc_sel', '''{"p2": true}''::jsonb #= jsonb_build_array(''p2'', id > 0)')).est;
 est 
-----
 500
(1 row)

CREATE TABLE wc_inc (id int, doc jsonb) WITH (autovacuum_enabled = off);
INSERT INTO wc_inc SELECT * FROM wc_sel;
CREATE INDEX wc_inc_doc ON wc_inc USING bark (doc bark_jsonb_wildcard_ops (include = 'id'));
ANALYZE wc_inc;
SELECT (wc_est('wc_inc', 'doc #= ''["p2", true]''')).est;
 est 
-----
 500
(1 row)

-- A parameter, in a generic plan: the cost estimate counts one boundary,
-- here through the RelabelType that makes the varchar a text.
PREPARE wc_sel_p(varchar) AS SELECT * FROM wc_sel WHERE doc #? $1;
SET plan_cache_mode = force_generic_plan;
EXPLAIN (COSTS OFF) EXECUTE wc_sel_p('p2');
               QUERY PLAN                
-----------------------------------------
 Bitmap Heap Scan on wc_sel
   Recheck Cond: (doc #? ($1)::text)
   ->  Bitmap Index Scan on wc_sel_doc
         Index Cond: (doc #? ($1)::text)
(4 rows)

RESET plan_cache_mode;
DEALLOCATE wc_sel_p;
SELECT n, q, act, est BETWEEN act / 3.0 AND act * 3.0 AS within_3x
  FROM wc_sel_q, LATERAL wc_est('wc_inc', q) WHERE n = 7;
 n |            q            |  act  | within_3x 
---+-------------------------+-------+-----------
 7 | doc #>= '["id", 50001]' | 50000 | t
(1 row)

DROP TABLE wc_inc;
-- Keys too long for a leaf live on overflow chains, and so do the
-- separators between them, which the sample leaves out; a narrow range
-- among them still lands within 3x.
CREATE TABLE wc_big (id int, doc jsonb) WITH (autovacuum_enabled = off);
INSERT INTO wc_big
  SELECT g, jsonb_build_object('k', lpad(g::text, 6, '0') || repeat('x', 3000))
    FROM generate_series(1, 2000) g;
CREATE INDEX wc_big_doc ON wc_big USING bark (doc bark_jsonb_wildcard_ops);
ANALYZE wc_big;
SELECT est BETWEEN act / 3.0 AND act * 3.0 AS within_3x, act
  FROM wc_est('wc_big', format('doc #< %L', jsonb_build_array('k', '000400')));
 within_3x | act 
-----------+-----
 t         | 399
(1 row)

DROP TABLE wc_big;
-- Keys that do not compress are OVERSIZED, separators too, so the sample
-- has no keys at all.  That says nothing of the distribution: a range or
-- point counted exactly within four leaves keeps its count, and a wider
-- one, #? 'k' here, keeps the default, 1% of 600 rows.
CREATE TABLE wc_wide (id int, doc jsonb) WITH (autovacuum_enabled = off);
INSERT INTO wc_wide
  SELECT g, jsonb_build_object('k', lpad(g::text, 6, '0') ||
           (SELECT string_agg(md5(g::text || i), '') FROM generate_series(1, 100) i))
    FROM generate_series(1, 600) g;
CREATE INDEX wc_wide_doc ON wc_wide USING bark (doc bark_jsonb_wildcard_ops);
ANALYZE wc_wide;
SELECT est, act
  FROM wc_est('wc_wide', format('doc #< %L', jsonb_build_array('k', '000300')));
 est | act 
-----+-----
 299 | 299
(1 row)

SELECT est, act
  FROM wc_est('wc_wide', format('doc #= %L',
                                (SELECT jsonb_build_array('k', doc ->> 'k')
                                   FROM wc_wide WHERE id = 300)));
 est | act 
-----+-----
   1 |   1
(1 row)

SELECT est, act FROM wc_est('wc_wide', 'doc #? ''k''');
 est | act 
-----+-----
   6 | 600
(1 row)

DROP TABLE wc_wide;
-- A one-leaf index cannot say, so the estimate stays the default: 0.5% of
-- 1000 rows for =, though every row matches.
CREATE TABLE wc_small (id int, doc jsonb) WITH (autovacuum_enabled = off);
INSERT INTO wc_small SELECT g, '{"p1": true}' FROM generate_series(1, 1000) g;
CREATE INDEX wc_small_doc ON wc_small USING bark (doc bark_jsonb_wildcard_ops);
ANALYZE wc_small;
SELECT est, act FROM wc_est('wc_small', 'doc #= ''["p1", true]''');
 est | act  
-----+------
   5 | 1000
(1 row)

-- A hypothetical index cannot say either: the default again.
SELECT bark_wildcard_hypothetical(true);
 bark_wildcard_hypothetical 
----------------------------
 
(1 row)

SELECT est, act FROM wc_est('wc_sel', 'doc #= ''["p1", true]''');
 est |  act  
-----+-------
 500 | 90000
(1 row)

SELECT bark_wildcard_hypothetical(false);
 bark_wildcard_hypothetical 
----------------------------
 
(1 row)

-- A user who may not read every row (here, under row-level security)
-- gets the default too, as jsonb_cmp is not leakproof: the index's counts
-- would tell them how many rows the policy hides.  The policy passes every row, so its own selectivity
-- is about 1: 500 rows is the default, 90000 would be the index's count.
CREATE ROLE regress_wc_sel;
GRANT SELECT ON wc_sel TO regress_wc_sel;
ALTER TABLE wc_sel ENABLE ROW LEVEL SECURITY;
CREATE POLICY wc_sel_few ON wc_sel TO regress_wc_sel USING (id > 0);
SET ROLE regress_wc_sel;
SELECT (wc_est('wc_sel', 'doc #= ''["p1", true]''')).est;
 est 
-----
 500
(1 row)

RESET ROLE;
ALTER TABLE wc_sel DISABLE ROW LEVEL SECURITY;
DROP POLICY wc_sel_few ON wc_sel;
REVOKE SELECT ON wc_sel FROM regress_wc_sel;
DROP ROLE regress_wc_sel;
-- A range past the leaf limit that the sample has no key inside (the
-- index grew after ANALYZE, and the sample is rebuilt only when the root
-- moves) takes the larger of its leaves' density over the interval, the
-- TIDs read and the half-interval fraction: here the density, still low
-- as the sample is stale.  Then a range whose four leaves hold only dead
-- entries, where the fraction is the largest.
CREATE TEMP TABLE wc_grow (id int, doc jsonb);
INSERT INTO wc_grow SELECT g, jsonb_build_object('id', g) FROM generate_series(1, 2000) g;
CREATE INDEX wc_grow_doc ON wc_grow USING bark (doc bark_jsonb_wildcard_ops);
ANALYZE wc_grow;
-- The sample lives in the index's relcache entry; the open cursor keeps it
-- (under RELCACHE_FORCE_RELEASE an entry nothing holds open is rebuilt,
-- with a fresh sample, after every statement).
BEGIN;
DECLARE pin CURSOR FOR SELECT id FROM wc_grow WHERE doc #= '["none", 0]';
SELECT est, act FROM wc_est('wc_grow', 'doc #>= ''["g", 0]''');
 est | act 
-----+-----
   1 |   0
(1 row)

INSERT INTO wc_grow SELECT g, jsonb_build_object('g', g) FROM generate_series(1, 3000) g;
INSERT INTO wc_grow SELECT g, jsonb_build_object('f', g) FROM generate_series(1, 3000) g;
DELETE FROM wc_grow WHERE doc ? 'f';
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT count(*) FROM wc_grow WHERE doc #>= '["f", 0]';
 count 
-------
     0
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
SELECT est < act AS low, act FROM wc_est('wc_grow', 'doc #>= ''["g", 0]''');
 low | act  
-----+------
 t   | 3000
(1 row)

SELECT est > 1 AS from_fraction, act FROM wc_est('wc_grow', 'doc #>= ''["f", 0]''');
 from_fraction | act 
---------------+-----
 t             |   0
(1 row)

COMMIT;
DROP TABLE wc_grow;
-- An empty build is one leaf, which cannot say: here a table never
-- analyzed, which the planner takes for ten pages of rows.  Nor can an
-- empty heap, once ANALYZE has counted it: the estimate is then one row.
CREATE TABLE wc_empty (id int, doc jsonb) WITH (autovacuum_enabled = off);
CREATE INDEX wc_empty_doc ON wc_empty USING bark (doc bark_jsonb_wildcard_ops);
SELECT est > 1 AS assumed_rows, act
  FROM wc_est('wc_empty', 'doc #= ''["p1", true]''');
 assumed_rows | act 
--------------+-----
 t            |   0
(1 row)

ANALYZE wc_empty;
SELECT est, act FROM wc_est('wc_empty', 'doc #= ''["p1", true]''');
 est | act 
-----+-----
   1 |   0
(1 row)

DROP TABLE wc_empty;
-- Entries an index scan marked dead (LP_DEAD: their rows are dead to every
-- snapshot, which a temp table keeps other sessions out of) are not
-- counted, in a leaf an exact count reads or one a wide range's density is
-- read from: v = 1 is deleted whole, and every other id after it.
CREATE TEMP TABLE wc_dead (id int, doc jsonb);
INSERT INTO wc_dead
  SELECT g, jsonb_build_object('id', g, 'v', CASE WHEN g <= 30000 THEN 1 ELSE 2 END)
    FROM generate_series(1, 40000) g;
CREATE INDEX wc_dead_doc ON wc_dead USING bark (doc bark_jsonb_wildcard_ops);
DELETE FROM wc_dead WHERE id <= 30000 OR id % 2 = 0;
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SELECT count(*) FROM wc_dead WHERE doc #= '["v", 1]';
 count 
-------
     0
(1 row)

SELECT count(*) FROM wc_dead WHERE doc #> '["id", 0]';
 count 
-------
  5000
(1 row)

RESET enable_seqscan;
RESET enable_bitmapscan;
ANALYZE wc_dead;
SELECT est, act FROM wc_est('wc_dead', 'doc #= ''["v", 1]''');
 est | act 
-----+-----
   1 |   0
(1 row)

SELECT q, act, est BETWEEN act / 3.0 AND act * 3.0 AS within_3x
  FROM (VALUES ('doc #= ''["v", 2]'''), ('doc #> ''["id", 100]''')) v(q),
       LATERAL wc_est('wc_dead', q);
          q           | act  | within_3x 
----------------------+------+-----------
 doc #= '["v", 2]'    | 5000 | t
 doc #> '["id", 100]' | 5000 | t
(2 rows)

DROP TABLE wc_dead;
-- bark_wildcard_sel serves any BARK operator.  bark_multikey's range class
-- makes boundaries open at one end (|>|, |<=|), and two for |<>|, whose
-- sum is more than every row; one past every key has no sample key inside,
-- so it is half an interval.  A procedure 8 that asks for a recheck,
-- |%|'s, cannot say (its boundaries hold more than the matches), nor can a
-- class with GIN's query interface (no procedure 8): each keeps the
-- default, 1% for |%|, and a third for %^%.
CREATE EXTENSION bark_multikey;
ALTER OPERATOR |>| (int4[], int4) SET (RESTRICT = bark_wildcard_sel);
ALTER OPERATOR |<=| (int4[], int4) SET (RESTRICT = bark_wildcard_sel);
ALTER OPERATOR |<>| (int4[], int4) SET (RESTRICT = bark_wildcard_sel);
ALTER OPERATOR |%| (int4[], int4[]) SET (RESTRICT = bark_wildcard_sel);
ALTER OPERATOR %^% (text[], text) SET (RESTRICT = bark_wildcard_sel);
CREATE TABLE wc_mk (id int, a int4[]) WITH (autovacuum_enabled = off);
INSERT INTO wc_mk SELECT g, ARRAY[g, 100000 + g % 100] FROM generate_series(1, 20000) g;
CREATE INDEX wc_mk_a ON wc_mk USING bark (a bark_int4_array_range_ops);
ANALYZE wc_mk;
SELECT q, act, est BETWEEN act / 3.0 AND act * 3.0 AS within_3x
  FROM (VALUES ('a |>| 100050'), ('a |<=| 15000'), ('a |<>| 100050')) v(q),
       LATERAL wc_est('wc_mk', q);
       q       |  act  | within_3x 
---------------+-------+-----------
 a |>| 100050  |  9800 | t
 a |<=| 15000  | 15000 | t
 a |<>| 100050 | 20000 | t
(3 rows)

SELECT est < 1000 AS few, act FROM wc_est('wc_mk', 'a |>| 200000');
 few | act 
-----+-----
 t   |   0
(1 row)

SELECT est, act FROM wc_est('wc_mk', 'a |%| ''{100002, 100004}''');
 est | act 
-----+-----
 200 | 400
(1 row)

CREATE TABLE wc_pfx (id int, t text[]) WITH (autovacuum_enabled = off);
INSERT INTO wc_pfx SELECT g, ARRAY['w' || g] FROM generate_series(1, 5000) g;
CREATE INDEX wc_pfx_t ON wc_pfx USING bark (t bark_text_prefix_ops);
ANALYZE wc_pfx;
SELECT est, act FROM wc_est('wc_pfx', 't %^% ''w12''');
 est  | act 
------+-----
 1667 | 111
(1 row)

DROP TABLE wc_mk, wc_pfx;
DROP EXTENSION bark_multikey;
-- The sample is rebuilt after each invalidation, in a memory context that
-- replaces the old one: ten ANALYZEs, each followed by a plan, must not
-- grow the index's relcache memory (a sample left behind by each would).
CREATE TEMP TABLE wc_cxt AS
  SELECT bark_wildcard_cxt_size('wc_sel_doc') AS before
    FROM wc_est('wc_sel', 'doc #= ''["p2", true]''');
DO $$
BEGIN
  FOR i IN 1..10 LOOP
    ANALYZE wc_sel;
    PERFORM wc_est('wc_sel', 'doc #= ''["p2", true]''');
  END LOOP;
END $$;
SELECT bark_wildcard_cxt_size('wc_sel_doc') - before AS grown FROM wc_cxt;
 grown 
-------
     0
(1 row)

DROP TABLE wc_sel, wc_sel_q, wc_small;
DROP FUNCTION wc_est;
DROP EXTENSION bark_wildcard;

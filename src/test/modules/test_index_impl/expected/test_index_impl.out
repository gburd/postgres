ALTER TABLE p ALTER COLUMN c TYPE varchar(20);
SELECT b.relname, b.impl, implam(c.oid)
  FROM pbefore b LEFT JOIN pg_class c USING (relname)
  WHERE implam(c.oid) IS DISTINCT FROM b.impl;

CREATE INDEX tmzh_doc ON tmzh USING bark (doc bark_int4_array_ops);
UPDATE pg_catalog.pg_index SET indisunique = true
  WHERE indexrelid IN ('tmz_doc'::regclass, 'tmzh_doc'::regclass);

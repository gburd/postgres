  ('tenant = 1 AND a && ''{5,77,150}'' AND id < 9000'),
  ('tenant = 1 AND a && ''{5,77,150}'' AND id > 9000'),
  ('tenant IN (1, 2) AND a |=| ANY (ARRAY[5, 77]) AND id BETWEEN 3000 AND 6000'),
  ('tenant = 1 AND a |><| ''{5,40}'' AND id < 9000'),
  ('tenant = 3 AND a |>| 250 AND id > 15000')) AS v(q);

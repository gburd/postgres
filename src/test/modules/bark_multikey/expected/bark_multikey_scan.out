 Sort
   Sort Key: ((a |<| 0))
   ->  Bitmap Heap Scan on mk_cost
         Recheck Cond: (a && '{7}'::integer[])
         ->  Bitmap Index Scan on mk_cost_a
               Index Cond: (a && '{7}'::integer[])
(6 rows)

DROP INDEX mk_cost_a;

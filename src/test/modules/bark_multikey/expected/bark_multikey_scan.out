 Aggregate
   ->  Sort
         Sort Key: s.id
         ->  Subquery Scan on s
               ->  Index Scan using mk_onf_a on mk_onf
                     Order By: (a |<| $1)
(6 rows)

EXECUTE mk_onull(NULL);

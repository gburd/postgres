ERROR:  relation "xc" does not exist
LINE 1: INSERT INTO xc VALUES (1, '{5,2}');
                    ^
INSERT INTO xc VALUES (2, '{3,4}'), (3, '{2}');
ERROR:  relation "xc" does not exist
LINE 1: INSERT INTO xc VALUES (2, '{3,4}'), (3, '{2}');
                    ^
SELECT tenant, a FROM xc ORDER BY tenant, a;
ERROR:  relation "xc" does not exist
LINE 1: SELECT tenant, a FROM xc ORDER BY tenant, a;
                              ^

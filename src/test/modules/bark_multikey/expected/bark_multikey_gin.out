SELECT count(*) FILTER (WHERE mg_run('mg_bark', q) = mg_run(NULL, q)) AS bark_ok,
       count(*) FILTER (WHERE mg_run('mg_gin', q) = mg_run(NULL, q)) AS gin_ok,
       count(*) AS total
FROM mg_q;
 bark_ok | gin_ok | total 
---------+--------+-------

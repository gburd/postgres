#include "utils/palloc.h"

extern void *plpgsql_yyAlloc(void *(*mallocProc)(size_t));
extern void plpgsql_yyLoc(void *yyp, int yymajor, YYSTYPE yyminor,
						  YYLTYPE yyloc, struct GramParseExtra *extra);
extern void plpgsql_yyFree(void *p, void (*freeProc)(void *));

static inline int
plpgsql_ascii_to_lime_token(int t)
{
	switch (t)
	{
		case '(':	return LPAREN;
		case ')':	return RPAREN;
		case '[':	return LBRACKET;
		case ']':	return RBRACKET;
		case ',':	return COMMA;
		case ';':	return SEMI;
		case ':':	return COLON;
		case '.':	return DOT;
		case '+':	return PLUS;
		case '-':	return MINUS;
		case '*':	return STAR;
		case '/':	return SLASH;
		case '%':	return PERCENT;
		case '^':	return CARET;
		case '|':	return PIPE;
		case '<':	return LT;
		case '>':	return GT;
		case '=':	return EQ;
		case '#':	return HASH;
		case '~':	return TILDE;
		case '?':	return QMARK;
		case '@':	return AT_SIGN;
		case '!':	return BANG;
		case '&':	return AMP;
		case '{':	return LBRACE;
		case '}':	return RBRACE;
		default:	return t;
	}
}

/* Reverse mapping: convert Lime symbolic codes back to the
 * raw ASCII the plpgsql lexer originally returned.  Used by
 * plpgsql_yy_drain_lookahead so a Lime lookahead pushed back
 * onto the lexer pushback stack pops out as the same numeric
 * token plpgsql_yylex would have returned, matching the
 * `tok == '['`-style comparisons in pl_gram.y action bodies.
 *
 * Called from pl_scanner.c; the self-extern below provides the
 * prototype at the definition site (the matching extern lives in
 * pl_scanner.c) so it is not flagged by -Wmissing-prototypes.
 */
extern int	plpgsql_lime_to_ascii_token(int t);
int
plpgsql_lime_to_ascii_token(int t)
{
	switch (t)
	{
		case LPAREN:	return '(';
		case RPAREN:	return ')';
		case LBRACKET:	return '[';
		case RBRACKET:	return ']';
		case COMMA:	return ',';
		case SEMI:	return ';';
		case COLON:	return ':';
		case DOT:	return '.';
		case PLUS:	return '+';
		case MINUS:	return '-';
		case STAR:	return '*';
		case SLASH:	return '/';
		case PERCENT:	return '%';
		case CARET:	return '^';
		case PIPE:	return '|';
		case LT:	return '<';
		case GT:	return '>';
		case EQ:	return '=';
		case HASH:	return '#';
		case TILDE:	return '~';
		case QMARK:	return '?';
		case AT_SIGN:	return '@';
		case BANG:	return '!';
		case AMP:	return '&';
		case LBRACE:	return '{';
		case RBRACE:	return '}';
		default:	return t;
	}
}

int
plpgsql_yyparse(PLpgSQL_stmt_block **plpgsql_parse_result_p, yyscan_t yyscanner)
{
	struct GramParseExtra	extra = {
		.plpgsql_parse_result_p = plpgsql_parse_result_p,
		.yyscanner = yyscanner,
	};
	void	   *parser;
	YYSTYPE		lval;
	YYLTYPE		lloc = 0;
	int			token;

	parser = plpgsql_yyAlloc(palloc);
	while ((token = plpgsql_yylex(&lval, &lloc, yyscanner)) != 0)
	{
		/* Mirror the state-mutating actions for tokens whose
		 * grammar reduce-action sets scanner state.  In Bison's
		 * pull model the action runs before the next yylex; in
		 * Lime's push model the next token is already in flight
		 * by the time the reduce fires, so the scanner sees the
		 * old state.  Driver-level mirroring keeps state changes
		 * in lockstep with the scanner. */
		switch (token)
		{
			case K_DECLARE:
				/* decl_start: K_DECLARE { plpgsql_IdentifierLookup =
				 * IDENTIFIER_LOOKUP_DECLARE; } */
				plpgsql_IdentifierLookup = IDENTIFIER_LOOKUP_DECLARE;
				break;
			case K_BEGIN:
				/* decl_sect's reduce action runs after BEGIN is
				 * shifted: plpgsql_IdentifierLookup =
				 * IDENTIFIER_LOOKUP_NORMAL */
				plpgsql_IdentifierLookup = IDENTIFIER_LOOKUP_NORMAL;
				break;
			default:
				break;
		}
		plpgsql_yyLoc(parser, plpgsql_ascii_to_lime_token(token),
					  lval, lloc, &extra);
	}
	plpgsql_yyLoc(parser, 0, lval, lloc, &extra);
	plpgsql_yyFree(parser, pfree);
	return 0;
}
}

%syntax_error {
	plpgsql_yyerror(&yyloc, extra->plpgsql_parse_result_p, extra->yyscanner, "syntax error");
}

%parse_failure {
	plpgsql_yyerror(&yypParser->yyLookaheadLoc, extra->plpgsql_parse_result_p, extra->yyscanner, "parse failure");
}


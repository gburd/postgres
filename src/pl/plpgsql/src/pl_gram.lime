							new->stmtid = ++plpgsql_curr_compile->nstatements;
							new->curvar = C->dno;
							new->cursor_options = CURSOR_OPT_FAST_PLAN;
	
							if (C->cursor_explicit_expr == NULL)
							{
								
								tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
								if (tok_is_keyword(tok, &yylval,
												   K_NO, "no"))
								{

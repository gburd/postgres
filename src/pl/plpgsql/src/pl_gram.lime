										tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
									}
								}
								else if (tok_is_keyword(tok, &yylval,
														K_SCROLL, "scroll"))
								{
									new->cursor_options |= CURSOR_OPT_SCROLL;
									tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
								}
	
								if (tok != K_FOR)
									plpgsql_yyerror(&yylloc, NULL, yyscanner, "syntax error, expected \"FOR\"");
	
								tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
								if (tok_is_keyword(tok, &yylval,
												   K_EXECUTE, "execute"))

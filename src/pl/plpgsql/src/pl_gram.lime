/* ----- stmt_assign ----- */
stmt_assign(A) ::= T_DATUM(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; YYSTYPE	yylval; YYLTYPE	yylloc; PLpgSQL_stmt_assign *new; RawParseMode pmode;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
		yylloc = @B;
		memset(&yylval, 0, sizeof(yylval));
		(void) plpgsql_yy_drain_lookahead(yypParser, extra->yyscanner);
	
	
							
							switch (B.wdatum.ident ? 1 : list_length(B.wdatum.idents))
							{
								case 1:
									pmode = RAW_PARSE_PLPGSQL_ASSIGN1;
									break;
								case 2:
									pmode = RAW_PARSE_PLPGSQL_ASSIGN2;
									break;
								case 3:
									pmode = RAW_PARSE_PLPGSQL_ASSIGN3;
									break;
								default:
									elog(ERROR, "unexpected number of names");
									pmode = 0; 
							}
	
							check_assignable(B.wdatum.datum, @B, yyscanner);
							new = palloc0_object(PLpgSQL_stmt_assign);
							new->cmd_type = PLPGSQL_STMT_ASSIGN;
							new->lineno = plpgsql_location_to_lineno(@B, yyscanner);
							new->stmtid = ++plpgsql_curr_compile->nstatements;
							new->varno = B.wdatum.datum->dno;
							
							plpgsql_push_back_token(T_DATUM, &yylval, &yylloc, yyscanner);
							new->expr = read_sql_construct(';', 0, 0, ";",
														   pmode,
														   false, true,
														   NULL, NULL,
														   &yylval, &yylloc, yyscanner);
							mark_expr_as_assignment_source(new->expr, B.wdatum.datum);
	
							A = (PLpgSQL_stmt *) new;
	}
}
/* ----- stmt_getdiag ----- */
stmt_getdiag(A) ::= K_GET(B) getdiag_area_opt(C) K_DIAGNOSTICS getdiag_list(E) SEMI. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; PLpgSQL_stmt_getdiag *new; ListCell	   *lc;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
	
							new = palloc0_object(PLpgSQL_stmt_getdiag);
							new->cmd_type = PLPGSQL_STMT_GETDIAG;
							new->lineno = plpgsql_location_to_lineno(@B, yyscanner);
							new->stmtid = ++plpgsql_curr_compile->nstatements;
							new->is_stacked = C;
							new->diag_items = E;
	
							
	
	
							foreach(lc, new->diag_items)
							{
								PLpgSQL_diag_item *ditem = (PLpgSQL_diag_item *) lfirst(lc);
	
								switch (ditem->kind)
								{
									
									case PLPGSQL_GETDIAG_ROW_COUNT:
									case PLPGSQL_GETDIAG_ROUTINE_OID:
										if (new->is_stacked)
											ereport(ERROR,
													(errcode(ERRCODE_SYNTAX_ERROR),
													 errmsg("diagnostics item %s is not allowed in GET STACKED DIAGNOSTICS",
															plpgsql_getdiag_kindname(ditem->kind)),
													 parser_errposition(@B)));
										break;
									
									case PLPGSQL_GETDIAG_ERROR_CONTEXT:
									case PLPGSQL_GETDIAG_ERROR_DETAIL:
									case PLPGSQL_GETDIAG_ERROR_HINT:
									case PLPGSQL_GETDIAG_RETURNED_SQLSTATE:
									case PLPGSQL_GETDIAG_COLUMN_NAME:
									case PLPGSQL_GETDIAG_CONSTRAINT_NAME:
									case PLPGSQL_GETDIAG_DATATYPE_NAME:
									case PLPGSQL_GETDIAG_MESSAGE_TEXT:
									case PLPGSQL_GETDIAG_TABLE_NAME:
									case PLPGSQL_GETDIAG_SCHEMA_NAME:
										if (!new->is_stacked)
											ereport(ERROR,
													(errcode(ERRCODE_SYNTAX_ERROR),
													 errmsg("diagnostics item %s is not allowed in GET CURRENT DIAGNOSTICS",
															plpgsql_getdiag_kindname(ditem->kind)),
													 parser_errposition(@B)));
										break;
									
									case PLPGSQL_GETDIAG_CONTEXT:
										break;
									default:
										elog(ERROR, "unrecognized diagnostic item kind: %d",
											 ditem->kind);
										break;
								}
							}
	
							A = (PLpgSQL_stmt *) new;
	}
}
/* ----- getdiag_area_opt ----- */
getdiag_area_opt(A) ::=. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = false;
	}
}
getdiag_area_opt(A) ::= K_CURRENT. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = false;
	}
}
getdiag_area_opt(A) ::= K_STACKED. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = true;
	}
}
/* ----- getdiag_list ----- */
getdiag_list(A) ::= getdiag_list(B) COMMA getdiag_list_item(D). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = lappend(B, D);
	}
}
getdiag_list(A) ::= getdiag_list_item(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = list_make1(B);
	}
}
/* ----- getdiag_list_item ----- */
getdiag_list_item(A) ::= getdiag_target(B) assign_operator getdiag_item(D). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; PLpgSQL_diag_item *new;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
	
							new = palloc_object(PLpgSQL_diag_item);
							new->target = B->dno;
							new->kind = D;
	
							A = new;
	}
}
/* ----- getdiag_item ----- */
getdiag_item(A) ::=. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; YYSTYPE	yylval; YYLTYPE	yylloc; int			tok;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
		(void) plpgsql_yy_get_lookahead(yypParser, &yylval, &yylloc);
		(void) plpgsql_yy_drain_lookahead(yypParser, extra->yyscanner);
	
							tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
	
							if (tok_is_keyword(tok, &yylval,
											   K_ROW_COUNT, "row_count"))
								A = PLPGSQL_GETDIAG_ROW_COUNT;
							else if (tok_is_keyword(tok, &yylval,
													K_PG_ROUTINE_OID, "pg_routine_oid"))
								A = PLPGSQL_GETDIAG_ROUTINE_OID;
							else if (tok_is_keyword(tok, &yylval,
													K_PG_CONTEXT, "pg_context"))
								A = PLPGSQL_GETDIAG_CONTEXT;
							else if (tok_is_keyword(tok, &yylval,
													K_PG_EXCEPTION_DETAIL, "pg_exception_detail"))
								A = PLPGSQL_GETDIAG_ERROR_DETAIL;
							else if (tok_is_keyword(tok, &yylval,
													K_PG_EXCEPTION_HINT, "pg_exception_hint"))
								A = PLPGSQL_GETDIAG_ERROR_HINT;
							else if (tok_is_keyword(tok, &yylval,
													K_PG_EXCEPTION_CONTEXT, "pg_exception_context"))
								A = PLPGSQL_GETDIAG_ERROR_CONTEXT;
							else if (tok_is_keyword(tok, &yylval,
													K_COLUMN_NAME, "column_name"))
								A = PLPGSQL_GETDIAG_COLUMN_NAME;
							else if (tok_is_keyword(tok, &yylval,
													K_CONSTRAINT_NAME, "constraint_name"))
								A = PLPGSQL_GETDIAG_CONSTRAINT_NAME;
							else if (tok_is_keyword(tok, &yylval,
													K_PG_DATATYPE_NAME, "pg_datatype_name"))
								A = PLPGSQL_GETDIAG_DATATYPE_NAME;
							else if (tok_is_keyword(tok, &yylval,
													K_MESSAGE_TEXT, "message_text"))
								A = PLPGSQL_GETDIAG_MESSAGE_TEXT;
							else if (tok_is_keyword(tok, &yylval,
													K_TABLE_NAME, "table_name"))
								A = PLPGSQL_GETDIAG_TABLE_NAME;
							else if (tok_is_keyword(tok, &yylval,
													K_SCHEMA_NAME, "schema_name"))
								A = PLPGSQL_GETDIAG_SCHEMA_NAME;
							else if (tok_is_keyword(tok, &yylval,
													K_RETURNED_SQLSTATE, "returned_sqlstate"))
								A = PLPGSQL_GETDIAG_RETURNED_SQLSTATE;
							else
								plpgsql_yyerror(&yylloc, NULL, yyscanner, "unrecognized GET DIAGNOSTICS item");
	}
}
/* ----- getdiag_target ----- */
getdiag_target(A) ::= T_DATUM(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
		(void) plpgsql_yy_drain_lookahead(yypParser, extra->yyscanner);
	
							
	
	
	
	
							if (B.wdatum.datum->dtype == PLPGSQL_DTYPE_ROW ||
								B.wdatum.datum->dtype == PLPGSQL_DTYPE_REC ||
								plpgsql_peek(yyscanner) == '[')
								ereport(ERROR,
										(errcode(ERRCODE_SYNTAX_ERROR),
										 errmsg("\"%s\" is not a scalar variable",
												NameOfDatum(&(B.wdatum))),
										 parser_errposition(@B)));
							check_assignable(B.wdatum.datum, @B, yyscanner);
							A = B.wdatum.datum;
	}
}
getdiag_target ::= T_WORD(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							
							word_is_not_variable(&(B.word), @B, yyscanner);
	}
}
getdiag_target ::= T_CWORD(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							
							cword_is_not_variable(&(B.cword), @B, yyscanner);
	}
}
/* ----- stmt_if ----- */
stmt_if(A) ::= K_IF(B) expr_until_then(C) proc_sect(D) stmt_elsifs(E) stmt_else(F) K_END K_IF SEMI. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; PLpgSQL_stmt_if *new;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
	
							new = palloc0_object(PLpgSQL_stmt_if);
							new->cmd_type = PLPGSQL_STMT_IF;
							new->lineno = plpgsql_location_to_lineno(@B, yyscanner);
							new->stmtid = ++plpgsql_curr_compile->nstatements;
							new->cond = C;
							new->then_body = D;
							new->elsif_list = E;
							new->else_body = F;
	
							A = (PLpgSQL_stmt *) new;
	}
}
/* ----- stmt_elsifs ----- */
stmt_elsifs(A) ::=. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = NIL;
	}
}
stmt_elsifs(A) ::= stmt_elsifs(B) K_ELSIF(C) expr_until_then(D) proc_sect(E). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; PLpgSQL_if_elsif *new;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
	
							new = palloc0_object(PLpgSQL_if_elsif);
							new->lineno = plpgsql_location_to_lineno(@C, yyscanner);
							new->cond = D;
							new->stmts = E;
	
							A = lappend(B, new);
	}
}
/* ----- stmt_else ----- */
stmt_else(A) ::=. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = NIL;
	}
}
stmt_else(A) ::= K_ELSE proc_sect(C). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = C;
	}
}
/* ----- stmt_case ----- */
stmt_case(A) ::= K_CASE(B) opt_expr_until_when(C) case_when_list(D) opt_case_else(E) K_END K_CASE SEMI. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
		(void) plpgsql_yy_drain_lookahead(yypParser, extra->yyscanner);
	
							A = make_case(@B, C, D, E, yyscanner);
	}
}
/* ----- opt_expr_until_when ----- */
opt_expr_until_when(A) ::=. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; YYSTYPE	yylval; YYLTYPE	yylloc; PLpgSQL_expr *expr; int			tok;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
		(void) plpgsql_yy_get_lookahead(yypParser, &yylval, &yylloc);
		(void) plpgsql_yy_drain_lookahead(yypParser, extra->yyscanner);
	
							expr = NULL;
							tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
	
							if (tok != K_WHEN)
							{
								plpgsql_push_back_token(tok, &yylval, &yylloc, yyscanner);
								expr = read_sql_expression(K_WHEN, "WHEN", &yylval, &yylloc, yyscanner);
							}
							plpgsql_push_back_token(K_WHEN, &yylval, &yylloc, yyscanner);
							A = expr;
	}
}
/* ----- case_when_list ----- */
case_when_list(A) ::= case_when_list(B) case_when(C). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = lappend(B, C);
	}
}
case_when_list(A) ::= case_when(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = list_make1(B);
	}
}
/* ----- case_when ----- */
case_when(A) ::= K_WHEN(B) expr_until_then(C) proc_sect(D). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; PLpgSQL_case_when *new;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							new = palloc_object(PLpgSQL_case_when);
	
							new->lineno	= plpgsql_location_to_lineno(@B, yyscanner);
							new->expr = C;
							new->stmts = D;
							A = new;
	}
}
/* ----- opt_case_else ----- */
opt_case_else(A) ::=. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = NIL;
	}
}
opt_case_else(A) ::= K_ELSE proc_sect(C). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							
	
	
	
	
	
							if (C != NIL)
								A = C;
							else
								A = list_make1(NULL);
	}
}
/* ----- stmt_loop ----- */
stmt_loop(A) ::= opt_loop_label(B) K_LOOP(C) loop_body(D). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; PLpgSQL_stmt_loop *new;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
	
							new = palloc0_object(PLpgSQL_stmt_loop);
							new->cmd_type = PLPGSQL_STMT_LOOP;
							new->lineno = plpgsql_location_to_lineno(@C, yyscanner);
							new->stmtid = ++plpgsql_curr_compile->nstatements;
							new->label = B;
							new->body = D.stmts;
	
							check_labels(B, D.end_label, D.end_label_location, yyscanner);
							plpgsql_ns_pop();
	
							A = (PLpgSQL_stmt *) new;
	}
}
/* ----- stmt_while ----- */
stmt_while(A) ::= opt_loop_label(B) K_WHILE(C) expr_until_loop(D) loop_body(E). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; PLpgSQL_stmt_while *new;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
	
							new = palloc0_object(PLpgSQL_stmt_while);
							new->cmd_type = PLPGSQL_STMT_WHILE;
							new->lineno = plpgsql_location_to_lineno(@C, yyscanner);
							new->stmtid	= ++plpgsql_curr_compile->nstatements;
							new->label = B;
							new->cond = D;
							new->body = E.stmts;
	
							check_labels(B, E.end_label, E.end_label_location, yyscanner);
							plpgsql_ns_pop();
	
							A = (PLpgSQL_stmt *) new;
	}
}
/* ----- stmt_for ----- */
stmt_for(A) ::= opt_loop_label(B) K_FOR(C) for_control(D) loop_body(E). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							
							if (D->cmd_type == PLPGSQL_STMT_FORI)
							{
								PLpgSQL_stmt_fori *new;
	
								new = (PLpgSQL_stmt_fori *) D;
								new->lineno = plpgsql_location_to_lineno(@C, yyscanner);
								new->label = B;
								new->body = E.stmts;
								A = (PLpgSQL_stmt *) new;
							}
							else
							{
								PLpgSQL_stmt_forq *new;
	
								Assert(D->cmd_type == PLPGSQL_STMT_FORS ||
									   D->cmd_type == PLPGSQL_STMT_FORC ||
									   D->cmd_type == PLPGSQL_STMT_DYNFORS);
								
								new = (PLpgSQL_stmt_forq *) D;
								new->lineno = plpgsql_location_to_lineno(@C, yyscanner);
								new->label = B;
								new->body = E.stmts;
								A = (PLpgSQL_stmt *) new;
							}
	
							check_labels(B, E.end_label, E.end_label_location, yyscanner);
							
							plpgsql_ns_pop();
	}
}
/* ----- for_control ----- */
for_control(A) ::= for_variable(B) K_IN. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; YYSTYPE	yylval; YYLTYPE	yylloc; int			tok; int			tokloc;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
		yylloc = @B;
		memset(&yylval, 0, sizeof(yylval));
		(void) plpgsql_yy_drain_lookahead(yypParser, extra->yyscanner);
	
							tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
							tokloc = yylloc;
	
							if (tok_is_keyword(tok, &yylval,
											   K_EXECUTE, "execute"))
							{
								
								PLpgSQL_stmt_dynfors *new;
								PLpgSQL_expr *expr;
								int			term;
	
								expr = read_sql_expression2(K_LOOP, K_USING,
															"LOOP or USING",
															&term, &yylval, &yylloc, yyscanner);
	
								new = palloc0_object(PLpgSQL_stmt_dynfors);
								new->cmd_type = PLPGSQL_STMT_DYNFORS;
								new->stmtid = ++plpgsql_curr_compile->nstatements;
								if (B.row)
								{
									new->var = (PLpgSQL_variable *) B.row;
									check_assignable(B.row, @B, yyscanner);
								}
								else if (B.scalar)
								{
									
									new->var = (PLpgSQL_variable *)
										make_scalar_list1(B.name, B.scalar,
														  B.lineno, @B, yyscanner);
									
								}
								else
								{
									ereport(ERROR,
											(errcode(ERRCODE_DATATYPE_MISMATCH),
											 errmsg("loop variable of loop over rows must be a record variable or list of scalar variables"),
											 parser_errposition(@B)));
								}
								new->query = expr;
	
								if (term == K_USING)
								{
									do
									{
										expr = read_sql_expression2(',', K_LOOP,
																	", or LOOP",
																	&term, &yylval, &yylloc, yyscanner);
										new->params = lappend(new->params, expr);
									} while (term == ',');
								}
	
								A = (PLpgSQL_stmt *) new;
							}
							else if (tok == T_DATUM &&
									 yylval.wdatum.datum->dtype == PLPGSQL_DTYPE_VAR &&
									 ((PLpgSQL_var *) yylval.wdatum.datum)->datatype->typoid == REFCURSOROID)
							{
								
								PLpgSQL_stmt_forc *new;
								PLpgSQL_var	*cursor = (PLpgSQL_var *) yylval.wdatum.datum;
	
								new = palloc0_object(PLpgSQL_stmt_forc);
								new->cmd_type = PLPGSQL_STMT_FORC;
								new->stmtid = ++plpgsql_curr_compile->nstatements;
								new->curvar = cursor->dno;
	
								
								if (B.scalar && B.row)
									ereport(ERROR,
											(errcode(ERRCODE_SYNTAX_ERROR),
											 errmsg("cursor FOR loop must have only one target variable"),
											 parser_errposition(@B)));
	
								
								if (cursor->cursor_explicit_expr == NULL)
									ereport(ERROR,
											(errcode(ERRCODE_SYNTAX_ERROR),
											 errmsg("cursor FOR loop must use a bound cursor variable"),
											 parser_errposition(tokloc)));
	
								
								new->argquery = read_cursor_args(cursor, K_LOOP, &yylval, &yylloc, yyscanner);
	
								
								new->var = (PLpgSQL_variable *)
									plpgsql_build_record(B.name,
														 B.lineno,
														 NULL,
														 RECORDOID,
														 true);
	
								A = (PLpgSQL_stmt *) new;
							}
							else
							{
								PLpgSQL_expr *expr1;
								int			expr1loc;
								bool		reverse = false;
	
								
	
	
	
	
	
	
	
	
	
	
	
								if (tok_is_keyword(tok, &yylval,
												   K_REVERSE, "reverse"))
									reverse = true;
								else
									plpgsql_push_back_token(tok, &yylval, &yylloc, yyscanner);
	
								
	
	
	
	
	
	
								expr1 = read_sql_construct(DOT_DOT,
														   K_LOOP,
														   0,
														   "LOOP",
														   RAW_PARSE_DEFAULT,
														   true,
														   false,
														   &expr1loc,
														   &tok,
														   &yylval, &yylloc, yyscanner);
	
								if (tok == DOT_DOT)
								{
									
									PLpgSQL_expr *expr2;
									PLpgSQL_expr *expr_by;
									PLpgSQL_var	*fvar;
									PLpgSQL_stmt_fori *new;
	
									
	
	
	
									expr1->parseMode = RAW_PARSE_PLPGSQL_EXPR;
									check_sql_expr(expr1->query, expr1->parseMode,
												   expr1loc, yyscanner);
	
									
									expr2 = read_sql_expression2(K_LOOP, K_BY,
																 "LOOP",
																 &tok, &yylval, &yylloc, yyscanner);
	
									
									if (tok == K_BY)
										expr_by = read_sql_expression(K_LOOP,
																	  "LOOP", &yylval, &yylloc, yyscanner);
									else
										expr_by = NULL;
	
									
									if (B.scalar && B.row)
										ereport(ERROR,
												(errcode(ERRCODE_SYNTAX_ERROR),
												 errmsg("integer FOR loop must have only one target variable"),
												 parser_errposition(@B)));
	
									
									fvar = (PLpgSQL_var *)
										plpgsql_build_variable(B.name,
															   B.lineno,
															   plpgsql_build_datatype(INT4OID,
																					  -1,
																					  InvalidOid,
																					  NULL),
															   true);
	
									new = palloc0_object(PLpgSQL_stmt_fori);
									new->cmd_type = PLPGSQL_STMT_FORI;
									new->stmtid	= ++plpgsql_curr_compile->nstatements;
									new->var = fvar;
									new->reverse = reverse;
									new->lower = expr1;
									new->upper = expr2;
									new->step = expr_by;
	
									A = (PLpgSQL_stmt *) new;
								}
								else
								{
									
	
	
									PLpgSQL_stmt_fors *new;
	
									if (reverse)
										ereport(ERROR,
												(errcode(ERRCODE_SYNTAX_ERROR),
												 errmsg("cannot specify REVERSE in query FOR loop"),
												 parser_errposition(tokloc)));
	
									
									check_sql_expr(expr1->query, expr1->parseMode,
												   expr1loc, yyscanner);
	
									new = palloc0_object(PLpgSQL_stmt_fors);
									new->cmd_type = PLPGSQL_STMT_FORS;
									new->stmtid = ++plpgsql_curr_compile->nstatements;
									if (B.row)
									{
										new->var = (PLpgSQL_variable *) B.row;
										check_assignable(B.row, @B, yyscanner);
									}
									else if (B.scalar)
									{
										
										new->var = (PLpgSQL_variable *)
											make_scalar_list1(B.name, B.scalar,
															  B.lineno, @B, yyscanner);
										
									}
									else
									{
										ereport(ERROR,
												(errcode(ERRCODE_SYNTAX_ERROR),
												 errmsg("loop variable of loop over rows must be a record variable or list of scalar variables"),
												 parser_errposition(@B)));
									}
	
									new->query = expr1;
									A = (PLpgSQL_stmt *) new;
								}
							}
	}
}
/* ----- for_variable ----- */
for_variable(A) ::= T_DATUM(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; YYSTYPE	yylval; YYLTYPE	yylloc;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
		yylloc = @B;
		memset(&yylval, 0, sizeof(yylval));
		(void) plpgsql_yy_drain_lookahead(yypParser, extra->yyscanner);
	
							A.name = NameOfDatum(&(B.wdatum));
							A.lineno = plpgsql_location_to_lineno(@B, yyscanner);
							if (B.wdatum.datum->dtype == PLPGSQL_DTYPE_ROW ||
								B.wdatum.datum->dtype == PLPGSQL_DTYPE_REC)
							{
								A.scalar = NULL;
								A.row = B.wdatum.datum;
							}
							else
							{
								int			tok;
	
								A.scalar = B.wdatum.datum;
								A.row = NULL;
								
								tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
								plpgsql_push_back_token(tok, &yylval, &yylloc, yyscanner);
								if (tok == ',')
									A.row = (PLpgSQL_datum *)
										read_into_scalar_list(A.name,
															  A.scalar,
															  @B,
															  &yylval, &yylloc,
															  yyscanner);
							}
	}
}
for_variable(A) ::= T_WORD(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; YYSTYPE	yylval; YYLTYPE	yylloc; int			tok;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
		yylloc = @B;
		memset(&yylval, 0, sizeof(yylval));
		(void) plpgsql_yy_drain_lookahead(yypParser, extra->yyscanner);
	
	
							A.name = B.word.ident;
							A.lineno = plpgsql_location_to_lineno(@B, yyscanner);
							A.scalar = NULL;
							A.row = NULL;
							
							tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
							plpgsql_push_back_token(tok, &yylval, &yylloc, yyscanner);
							if (tok == ',')
								word_is_not_variable(&(B.word), @B, yyscanner);
	}
}
for_variable ::= T_CWORD(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							
							cword_is_not_variable(&(B.cword), @B, yyscanner);
	}
}
/* ----- stmt_foreach_a ----- */
stmt_foreach_a(A) ::= opt_loop_label(B) K_FOREACH(C) for_variable(D) foreach_slice(E) K_IN K_ARRAY expr_until_loop(H) loop_body(I). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; PLpgSQL_stmt_foreach_a *new;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
	
							new = palloc0_object(PLpgSQL_stmt_foreach_a);
							new->cmd_type = PLPGSQL_STMT_FOREACH_A;
							new->lineno = plpgsql_location_to_lineno(@C, yyscanner);
							new->stmtid = ++plpgsql_curr_compile->nstatements;
							new->label = B;
							new->slice = E;
							new->expr = H;
							new->body = I.stmts;
	
							if (D.row)
							{
								new->varno = D.row->dno;
								check_assignable(D.row, @D, yyscanner);
							}
							else if (D.scalar)
							{
								new->varno = D.scalar->dno;
								check_assignable(D.scalar, @D, yyscanner);
							}
							else
							{
								ereport(ERROR,
										(errcode(ERRCODE_SYNTAX_ERROR),
										 errmsg("loop variable of FOREACH must be a known variable or list of variables"),
												 parser_errposition(@D)));
							}
	
							check_labels(B, I.end_label, I.end_label_location, yyscanner);
							plpgsql_ns_pop();
	
							A = (PLpgSQL_stmt *) new;
	}
}
/* ----- foreach_slice ----- */
foreach_slice(A) ::=. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = 0;
	}
}
foreach_slice(A) ::= K_SLICE ICONST(C). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = C.ival;
	}
}
/* ----- stmt_exit ----- */
stmt_exit(A) ::= exit_type(B) opt_label(C) opt_exitcond(D). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; PLpgSQL_stmt_exit *new;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
	
							new = palloc0_object(PLpgSQL_stmt_exit);
							new->cmd_type = PLPGSQL_STMT_EXIT;
							new->stmtid = ++plpgsql_curr_compile->nstatements;
							new->is_exit = B;
							new->lineno	= plpgsql_location_to_lineno(@B, yyscanner);
							new->label = C;
							new->cond = D;
	
							if (C)
							{
								
								PLpgSQL_nsitem *label;
	
								label = plpgsql_ns_lookup_label(plpgsql_ns_top(), C);
								if (label == NULL)
									ereport(ERROR,
											(errcode(ERRCODE_SYNTAX_ERROR),
											 errmsg("there is no label \"%s\" "
													"attached to any block or loop enclosing this statement",
													C),
											 parser_errposition(@C)));
								
								if (label->itemno != PLPGSQL_LABEL_LOOP && !new->is_exit)
									ereport(ERROR,
											(errcode(ERRCODE_SYNTAX_ERROR),
											 errmsg("block label \"%s\" cannot be used in CONTINUE",
													C),
											 parser_errposition(@C)));
							}
							else
							{
								
	
	
	
	
								if (plpgsql_ns_find_nearest_loop(plpgsql_ns_top()) == NULL)
									ereport(ERROR,
											(errcode(ERRCODE_SYNTAX_ERROR),
											 new->is_exit ?
											 errmsg("EXIT cannot be used outside a loop, unless it has a label") :
											 errmsg("CONTINUE cannot be used outside a loop"),
											 parser_errposition(@B)));
							}
	
							A = (PLpgSQL_stmt *) new;
	}
}
/* ----- exit_type ----- */
exit_type(A) ::= K_EXIT. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = true;
	}
}
exit_type(A) ::= K_CONTINUE. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = false;
	}
}
/* ----- stmt_return ----- */
stmt_return(A) ::= K_RETURN(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; YYSTYPE	yylval; YYLTYPE	yylloc; int			tok;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
		yylloc = @B;
		memset(&yylval, 0, sizeof(yylval));
		(void) plpgsql_yy_drain_lookahead(yypParser, extra->yyscanner);
	
	
							tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
							if (tok == 0)
								plpgsql_yyerror(&yylloc, NULL, yyscanner, "unexpected end of function definition");
	
							if (tok_is_keyword(tok, &yylval,
											   K_NEXT, "next"))
							{
								A = make_return_next_stmt(@B, &yylval, &yylloc, yyscanner);
							}
							else if (tok_is_keyword(tok, &yylval,
													K_QUERY, "query"))
							{
								A = make_return_query_stmt(@B, &yylval, &yylloc, yyscanner);
							}
							else
							{
								plpgsql_push_back_token(tok, &yylval, &yylloc, yyscanner);
								A = make_return_stmt(@B, &yylval, &yylloc, yyscanner);
							}
	}
}
/* ----- stmt_raise ----- */
stmt_raise(A) ::= K_RAISE(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; YYSTYPE	yylval; YYLTYPE	yylloc; PLpgSQL_stmt_raise *new; int			tok;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
		yylloc = @B;
		memset(&yylval, 0, sizeof(yylval));
		(void) plpgsql_yy_drain_lookahead(yypParser, extra->yyscanner);
	
	
							new = palloc_object(PLpgSQL_stmt_raise);
	
							new->cmd_type = PLPGSQL_STMT_RAISE;
							new->lineno = plpgsql_location_to_lineno(@B, yyscanner);
							new->stmtid	= ++plpgsql_curr_compile->nstatements;
							new->elog_level = ERROR;	
							new->condname = NULL;
							new->message = NULL;
							new->params = NIL;
							new->options = NIL;
	
							tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
							if (tok == 0)
								plpgsql_yyerror(&yylloc, NULL, yyscanner, "unexpected end of function definition");
	
							
	
	
	
							if (tok != ';')
							{
								
	
	
								if (tok_is_keyword(tok, &yylval,
												   K_EXCEPTION, "exception"))
								{
									new->elog_level = ERROR;
									tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
								}
								else if (tok_is_keyword(tok, &yylval,
														K_WARNING, "warning"))
								{
									new->elog_level = WARNING;
									tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
								}
								else if (tok_is_keyword(tok, &yylval,
														K_NOTICE, "notice"))
								{
									new->elog_level = NOTICE;
									tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
								}
								else if (tok_is_keyword(tok, &yylval,
														K_INFO, "info"))
								{
									new->elog_level = INFO;
									tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
								}
								else if (tok_is_keyword(tok, &yylval,
														K_LOG, "log"))
								{
									new->elog_level = LOG;
									tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
								}
								else if (tok_is_keyword(tok, &yylval,
														K_DEBUG, "debug"))
								{
									new->elog_level = DEBUG1;
									tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
								}
								if (tok == 0)
									plpgsql_yyerror(&yylloc, NULL, yyscanner, "unexpected end of function definition");
	
								
	
	
	
	
	
								if (tok == SCONST)
								{
									
									new->message = yylval.str;
									
	
	
	
	
	
									tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
									if (tok != ',' && tok != ';' && tok != K_USING)
										plpgsql_yyerror(&yylloc, NULL, yyscanner, "syntax error");
	
									while (tok == ',')
									{
										PLpgSQL_expr *expr;
	
										expr = read_sql_construct(',', ';', K_USING,
																  ", or ; or USING",
																  RAW_PARSE_PLPGSQL_EXPR,
																  true, true,
																  NULL, &tok,
																  &yylval, &yylloc, yyscanner);
										new->params = lappend(new->params, expr);
									}
								}
								else if (tok != K_USING)
								{
									
									if (tok_is_keyword(tok, &yylval,
													   K_SQLSTATE, "sqlstate"))
									{
										
										char	   *sqlstatestr;
	
										if (plpgsql_yylex(&yylval, &yylloc, yyscanner) != SCONST)
											plpgsql_yyerror(&yylloc, NULL, yyscanner, "syntax error");
										sqlstatestr = yylval.str;
	
										if (strlen(sqlstatestr) != 5)
											plpgsql_yyerror(&yylloc, NULL, yyscanner, "invalid SQLSTATE code");
										if (strspn(sqlstatestr, "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ") != 5)
											plpgsql_yyerror(&yylloc, NULL, yyscanner, "invalid SQLSTATE code");
										new->condname = sqlstatestr;
									}
									else
									{
										if (tok == T_WORD)
											new->condname = yylval.word.ident;
										else if (plpgsql_token_is_unreserved_keyword(tok))
											new->condname = pstrdup(yylval.keyword);
										else
											plpgsql_yyerror(&yylloc, NULL, yyscanner, "syntax error");
										plpgsql_recognize_err_condition(new->condname,
																		false);
									}
									tok = plpgsql_yylex(&yylval, &yylloc, yyscanner);
									if (tok != ';' && tok != K_USING)
										plpgsql_yyerror(&yylloc, NULL, yyscanner, "syntax error");
								}
	
								if (tok == K_USING)
									new->options = read_raise_options(&yylval, &yylloc, yyscanner);
							}
	
							check_raise_parameters(new);
	
							A = (PLpgSQL_stmt *) new;
	}
}
/* ----- stmt_assert ----- */
stmt_assert(A) ::= K_ASSERT(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; YYSTYPE	yylval; YYLTYPE	yylloc; PLpgSQL_stmt_assert	*new; int			tok;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
		yylloc = @B;
		memset(&yylval, 0, sizeof(yylval));
		(void) plpgsql_yy_drain_lookahead(yypParser, extra->yyscanner);
	
	
							new = palloc_object(PLpgSQL_stmt_assert);
	
							new->cmd_type = PLPGSQL_STMT_ASSERT;
							new->lineno = plpgsql_location_to_lineno(@B, yyscanner);
							new->stmtid = ++plpgsql_curr_compile->nstatements;
	
							new->cond = read_sql_expression2(',', ';',
															 ", or ;",
															 &tok, &yylval, &yylloc, yyscanner);
	
							if (tok == ',')
								new->message = read_sql_expression(';', ";", &yylval, &yylloc, yyscanner);
							else
								new->message = NULL;
	
							A = (PLpgSQL_stmt *) new;
	}
}
/* ----- loop_body ----- */
loop_body(A) ::= proc_sect(B) K_END K_LOOP opt_label(E) SEMI. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A.stmts = B;
							A.end_label = E;
							A.end_label_location = @E;
	}
}
/* ----- stmt_execsql ----- */
stmt_execsql(A) ::= K_IMPORT(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; YYSTYPE	yylval; YYLTYPE	yylloc;;

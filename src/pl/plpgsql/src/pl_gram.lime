/* ======================================================================
 * NON-TERMINAL TYPES
 * ====================================================================== */
%type decl_sect {struct { char *label; int n_initvars; int *initvarnos; }}
%type decl_varname {struct { char *name; int lineno; }}
%type decl_cursor_intro {struct { char *name; int lineno; int cursor_options; }}
%type decl_const {bool}
%type decl_notnull {bool}
%type exit_type {bool}
%type decl_defval {PLpgSQL_expr *}
%type decl_cursor_query {PLpgSQL_expr *}
%type decl_datatype {PLpgSQL_type *}
%type decl_collate {Oid}
%type decl_cursor_args {PLpgSQL_datum *}
%type decl_cursor_arglist {List *}
%type decl_aliasitem {PLpgSQL_nsitem *}
%type expr_until_semi {PLpgSQL_expr *}
%type expr_until_then {PLpgSQL_expr *}
%type expr_until_loop {PLpgSQL_expr *}
%type opt_expr_until_when {PLpgSQL_expr *}
%type opt_exitcond {PLpgSQL_expr *}
%type cursor_variable {PLpgSQL_var *}
%type decl_cursor_arg {PLpgSQL_datum *}
%type for_variable {struct { char *name; int lineno; PLpgSQL_datum *scalar; PLpgSQL_datum *row; }}
%type foreach_slice {int}
%type for_control {PLpgSQL_stmt *}
%type any_identifier {char *}
%type opt_block_label {char *}
%type opt_loop_label {char *}
%type opt_label {char *}
%type option_value {char *}
%type proc_sect {List *}
%type stmt_elsifs {List *}
%type stmt_else {List *}
%type loop_body {struct { List *stmts; char *end_label; int end_label_location; }}
%type proc_stmt {PLpgSQL_stmt *}
%type pl_block {PLpgSQL_stmt *}
%type stmt_assign {PLpgSQL_stmt *}
%type stmt_if {PLpgSQL_stmt *}
%type stmt_loop {PLpgSQL_stmt *}
%type stmt_while {PLpgSQL_stmt *}
%type stmt_exit {PLpgSQL_stmt *}
%type stmt_return {PLpgSQL_stmt *}
%type stmt_raise {PLpgSQL_stmt *}
%type stmt_assert {PLpgSQL_stmt *}
%type stmt_execsql {PLpgSQL_stmt *}
%type stmt_dynexecute {PLpgSQL_stmt *}
%type stmt_for {PLpgSQL_stmt *}
%type stmt_perform {PLpgSQL_stmt *}
%type stmt_call {PLpgSQL_stmt *}
%type stmt_getdiag {PLpgSQL_stmt *}
%type stmt_open {PLpgSQL_stmt *}
%type stmt_fetch {PLpgSQL_stmt *}
%type stmt_move {PLpgSQL_stmt *}
%type stmt_close {PLpgSQL_stmt *}

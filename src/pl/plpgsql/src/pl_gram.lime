/* ======================================================================
 * GRAMMAR RULES
 * ====================================================================== */

/* ----- pl_function ----- */
pl_function ::= comp_options pl_block(C) opt_semi. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							*plpgsql_parse_result_p = (PLpgSQL_stmt_block *) C;
	}
}
/* ----- comp_options ----- */
comp_options ::=.
/* empty */
comp_options ::= comp_options comp_option.
/* ----- comp_option ----- */
comp_option ::= HASH K_OPTION K_DUMP. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							plpgsql_DumpExecTree = true;
	}
}
comp_option ::= HASH K_PRINT_STRICT_PARAMS option_value(D). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							if (strcmp(D, "on") == 0)
								plpgsql_curr_compile->print_strict_params = true;
							else if (strcmp(D, "off") == 0)
								plpgsql_curr_compile->print_strict_params = false;
							else
								elog(ERROR, "unrecognized print_strict_params option %s", D);
	}
}
comp_option ::= HASH K_VARIABLE_CONFLICT K_ERROR. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							plpgsql_curr_compile->resolve_option = PLPGSQL_RESOLVE_ERROR;
	}
}
comp_option ::= HASH K_VARIABLE_CONFLICT K_USE_VARIABLE. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							plpgsql_curr_compile->resolve_option = PLPGSQL_RESOLVE_VARIABLE;
	}
}
comp_option ::= HASH K_VARIABLE_CONFLICT K_USE_COLUMN. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							plpgsql_curr_compile->resolve_option = PLPGSQL_RESOLVE_COLUMN;
	}
}
/* ----- option_value ----- */
option_value(A) ::= T_WORD(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
						A = B.word.ident;
	}
}
option_value(A) ::= unreserved_keyword(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
						A = pstrdup(B);
	}
}
/* ----- opt_semi ----- */
opt_semi ::=.
/* empty */
opt_semi(A) ::= SEMI(B). {
	A = B;
}
/* ----- pl_block ----- */
pl_block(A) ::= decl_sect(B) K_BEGIN(C) proc_sect(D) exception_sect(E) K_END opt_label(G). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; PLpgSQL_stmt_block *new;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
	
							new = palloc0_object(PLpgSQL_stmt_block);
	
							new->cmd_type	= PLPGSQL_STMT_BLOCK;
							new->lineno		= plpgsql_location_to_lineno(@C, yyscanner);
							new->stmtid		= ++plpgsql_curr_compile->nstatements;
							new->label		= B.label;
							new->n_initvars = B.n_initvars;
							new->initvarnos = B.initvarnos;
							new->body		= D;
							new->exceptions	= E;
	
							check_labels(B.label, G, @G, yyscanner);
							plpgsql_ns_pop();
	
							A = (PLpgSQL_stmt *) new;
	}
}
/* ----- decl_sect ----- */
decl_sect(A) ::= opt_block_label(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							
							plpgsql_IdentifierLookup = IDENTIFIER_LOOKUP_NORMAL;
							A.label	  = B;
							A.n_initvars = 0;
							A.initvarnos = NULL;
	}
}
decl_sect(A) ::= opt_block_label(B) decl_start. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							plpgsql_IdentifierLookup = IDENTIFIER_LOOKUP_NORMAL;
							A.label	  = B;
							A.n_initvars = 0;
							A.initvarnos = NULL;
	}
}
decl_sect(A) ::= opt_block_label(B) decl_start decl_stmts. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							plpgsql_IdentifierLookup = IDENTIFIER_LOOKUP_NORMAL;
							A.label	  = B;
							
							A.n_initvars = plpgsql_add_initdatums(&(A.initvarnos));
	}
}
/* ----- decl_start ----- */
decl_start ::= K_DECLARE. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							
							plpgsql_add_initdatums(NULL);
							
	
	
	
							plpgsql_IdentifierLookup = IDENTIFIER_LOOKUP_DECLARE;
	}
}
/* ----- decl_stmts ----- */
decl_stmts ::= decl_stmts decl_stmt.
decl_stmts(A) ::= decl_stmt(B). {
	A = B;
}
/* ----- decl_stmt ----- */
decl_stmt(A) ::= decl_statement(B). {
	A = B;
}
decl_stmt ::= K_DECLARE. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
	}
}
decl_stmt ::= LESS_LESS(B) any_identifier GREATER_GREATER. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							
	
	
	
							ereport(ERROR,
									(errcode(ERRCODE_SYNTAX_ERROR),
									 errmsg("block label must be placed before DECLARE, not after"),
									 parser_errposition(@B)));
	}
}
/* ----- decl_statement ----- */
decl_statement ::= decl_varname(B) decl_const(C) decl_datatype(D) decl_collate(E) decl_notnull(F) decl_defval(G). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; PLpgSQL_variable	*var;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
	
							
	
	
	
	
	
							if (OidIsValid(E))
							{
								if (!OidIsValid(D->collation))
									ereport(ERROR,
											(errcode(ERRCODE_DATATYPE_MISMATCH),
											 errmsg("collations are not supported by type %s",
													format_type_be(D->typoid)),
											 parser_errposition(@E)));
								D->collation = E;
							}
	
							var = plpgsql_build_variable(B.name, B.lineno,
														 D, true);
							var->isconst = C;
							var->notnull = F;
							var->default_val = G;
	
							
	
	
	
							if (var->notnull && var->default_val == NULL)
								ereport(ERROR,
										(errcode(ERRCODE_NULL_VALUE_NOT_ALLOWED),
										 errmsg("variable \"%s\" must have a default value, since it's declared NOT NULL",
												var->refname),
										 parser_errposition(@F)));
	
							if (var->default_val != NULL)
								mark_expr_as_assignment_source(var->default_val,
															   (PLpgSQL_datum *) var);
	}
}
decl_statement ::= decl_varname(B) K_ALIAS K_FOR decl_aliasitem(E) SEMI. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							plpgsql_ns_additem(E->itemtype,
											   E->itemno, B.name);
	}
}
decl_statement ::= decl_cursor_intro(B) decl_cursor_args(C) decl_is_for decl_cursor_query(E). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; PLpgSQL_var *new;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
	
							
							plpgsql_ns_pop();
	
							new = (PLpgSQL_var *)
								plpgsql_build_variable(B.name, B.lineno,
													   plpgsql_build_datatype(REFCURSOROID,
																			  -1,
																			  InvalidOid,
																			  NULL),
													   true);
	
							new->cursor_explicit_expr = E;
							if (C == NULL)
								new->cursor_explicit_argrow = -1;
							else
								new->cursor_explicit_argrow = C->dno;
							new->cursor_options = CURSOR_OPT_FAST_PLAN | B.cursor_options;
	}
}
/* ----- decl_cursor_intro ----- */
decl_cursor_intro(A) ::= decl_varname(B) opt_scrollable(C) K_CURSOR. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							plpgsql_ns_push(B.name, PLPGSQL_LABEL_OTHER);
							A.name = B.name;
							A.lineno = B.lineno;
							A.cursor_options = C;
	}
}
/* ----- opt_scrollable ----- */
opt_scrollable(A) ::=. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = 0;
	}
}
opt_scrollable(A) ::= K_NO K_SCROLL. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = CURSOR_OPT_NO_SCROLL;
	}
}
opt_scrollable(A) ::= K_SCROLL. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = CURSOR_OPT_SCROLL;
	}
}
/* ----- decl_cursor_query ----- */
decl_cursor_query(A) ::=. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; YYSTYPE	yylval; YYLTYPE	yylloc;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
		(void) plpgsql_yy_get_lookahead(yypParser, &yylval, &yylloc);
		(void) plpgsql_yy_drain_lookahead(yypParser, extra->yyscanner);
	
							A = read_sql_stmt(&yylval, &yylloc, yyscanner);
	}
}
/* ----- decl_cursor_args ----- */
decl_cursor_args(A) ::=. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = NULL;
	}
}
decl_cursor_args(A) ::= LPAREN(B) decl_cursor_arglist(C) RPAREN. {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner; PLpgSQL_row *new; int			i; ListCell   *l;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
	
							new = palloc0_object(PLpgSQL_row);
							new->dtype = PLPGSQL_DTYPE_ROW;
							new->refname = "(unnamed row)";
							new->lineno = plpgsql_location_to_lineno(@B, yyscanner);
							new->rowtupdesc = NULL;
							new->nfields = list_length(C);
							new->fieldnames = palloc_array(char *, new->nfields);
							new->varnos = palloc_array(int, new->nfields);
	
							i = 0;
							foreach (l, C)
							{
								PLpgSQL_variable *arg = (PLpgSQL_variable *) lfirst(l);
								Assert(!arg->isconst);
								new->fieldnames[i] = arg->refname;
								new->varnos[i] = arg->dno;
								i++;
							}
							list_free(C);
	
							plpgsql_adddatum((PLpgSQL_datum *) new);
							A = (PLpgSQL_datum *) new;
	}
}
/* ----- decl_cursor_arglist ----- */
decl_cursor_arglist(A) ::= decl_cursor_arg(B). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = list_make1(B);
	}
}
decl_cursor_arglist(A) ::= decl_cursor_arglist(B) COMMA decl_cursor_arg(D). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;
		(void)plpgsql_parse_result_p; (void)yyscanner;
	
							A = lappend(B, D);
	}
}
/* ----- decl_cursor_arg ----- */
decl_cursor_arg(A) ::= decl_varname(B) decl_datatype(C). {
	{ PLpgSQL_stmt_block **plpgsql_parse_result_p = extra->plpgsql_parse_result_p; yyscan_t yyscanner = extra->yyscanner;;

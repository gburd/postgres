						n->name = D;
						n->missing_ok = true;
						A = (Node *) n;
}
alter_table_cmd(A) ::= ALTER opt_column colId(D) SET STATISTICS set_statistics_value(G). {
	AlterTableCmd *n = makeNode(AlterTableCmd);
	
						n->subtype = AT_SetStatistics;
						n->name = D;
						n->def = G;
						A = (Node *) n;
}
alter_table_cmd(A) ::= ALTER opt_column iconst(D) SET STATISTICS set_statistics_value(G). {
	AlterTableCmd *n = makeNode(AlterTableCmd);
	
						if (D <= 0 || D > PG_INT16_MAX)
							ereport(ERROR,
									(errcode(ERRCODE_INVALID_PARAMETER_VALUE),
									 errmsg("column number must be in range from 1 to %d", PG_INT16_MAX),
									 parser_errposition(@D)));
	
						n->subtype = AT_SetStatistics;
						n->num = (int16) D;
						n->def = G;
						A = (Node *) n;
}

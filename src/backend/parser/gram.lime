						ai->lidx = NULL;
						ai->uidx = C;
						A = (Node *) ai;
}
indirection_el(A) ::= LBRACKET opt_slice_bound(C) COLON opt_slice_bound(E) RBRACKET. {
	A_Indices *ai = makeNode(A_Indices);
	
						ai->is_slice = true;
						ai->lidx = C;
						ai->uidx = E;

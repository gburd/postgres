}
/* ----- substr_list ----- */
substr_list(A) ::= a_expr(B) FROM a_expr(D) FOR a_expr(F). {
	A = list_make3(B, D, F);
}
substr_list(A) ::= a_expr(B) FOR a_expr(D) FROM a_expr(F). {
	A = list_make3(B, F, D);
}
substr_list(A) ::= a_expr(B) FROM a_expr(D). {
	A = list_make2(B, D);
}

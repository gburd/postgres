						n->options = NULL;
						A = (Node *) n;
}
dropdbStmt(A) ::= DROP DATABASE name(D) opt_with LPAREN drop_option_list(G) RPAREN. {
	DropdbStmt *n = makeNode(DropdbStmt);
	
						n->dbname = D;
						n->missing_ok = false;
						n->options = G;
						A = (Node *) n;
}
dropdbStmt(A) ::= DROP DATABASE IF_P EXISTS name(F) opt_with LPAREN drop_option_list(I) RPAREN. {
	DropdbStmt *n = makeNode(DropdbStmt);
	
						n->dbname = F;
						n->missing_ok = true;
						n->options = I;
						A = (Node *) n;
}
/* ----- drop_option_list ----- */
drop_option_list(A) ::= drop_option(B). {
	A = list_make1((Node *) B);
}
drop_option_list(A) ::= drop_option_list(B) COMMA drop_option(D). {
	A = lappend(B, (Node *) D);
}
/* ----- drop_option ----- */
drop_option(A) ::= FORCE(B). {
	A = makeDefElem("force", NULL, @B);
}
/* ----- alterCollationStmt ----- */
alterCollationStmt(A) ::= ALTER COLLATION any_name(D) REFRESH VERSION_P. {

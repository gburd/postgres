						A = (Node *) n;
}
alter_table_cmd(A) ::= ALTER opt_column colId(D) DROP EXPRESSION. {
	AlterTableCmd *n = makeNode(AlterTableCmd);
	
						n->subtype = AT_DropExpression;
						n->name = D;
						A = (Node *) n;
}
alter_table_cmd(A) ::= ALTER opt_column colId(D) DROP EXPRESSION IF_P EXISTS. {

alter_table_cmd(A) ::= ALTER opt_column colId(D) ADD_P GENERATED(F) generated_when(G) AS IDENTITY_P optParenthesizedSeqOptList(J). {
	AlterTableCmd *n = makeNode(AlterTableCmd);
						Constraint *c = makeNode(Constraint);
	
						c->contype = CONSTR_IDENTITY;
						c->generated_when = G;
						c->options = J;
						c->location = @F;
	
						n->subtype = AT_AddIdentity;
						n->name = D;
						n->def = (Node *) c;
	
						A = (Node *) n;
}

case_default(A) ::= ELSE a_expr(C). {
	A = C;
}
case_default(A) ::=. {
	A = NULL;
}
/* ----- case_arg ----- */
case_arg(A) ::= a_expr(B). {
	A = B;
}
case_arg(A) ::=. {
	A = NULL;
}
/* ----- columnref ----- */
columnref(A) ::= colId(B). {

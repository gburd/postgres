when_clause(A) ::= WHEN(B) a_expr(C) THEN a_expr(E). {
	CaseWhen   *w = makeNode(CaseWhen);
	
						w->expr = (Expr *) C;
						w->result = (Expr *) E;
						w->location = @B;
						A = (Node *) w;
}

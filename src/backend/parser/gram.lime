subquery_Op(A) ::= OPERATOR LPAREN any_operator(D) RPAREN. {
	A = D;
}
subquery_Op(A) ::= LIKE. {
	A = list_make1(makeString("~~"));
}
subquery_Op(A) ::= NOT_LA LIKE. {
	A = list_make1(makeString("!~~"));
}
subquery_Op(A) ::= ILIKE. {
	A = list_make1(makeString("~~*"));
}
subquery_Op(A) ::= NOT_LA ILIKE. {

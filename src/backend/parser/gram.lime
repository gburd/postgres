}
type_list(A) ::= type_list(B) COMMA typename(D). {
	A = lappend(B, D);
}
/* ----- array_expr ----- */
array_expr(A) ::= LBRACKET(B) expr_list(C) RBRACKET(D). {
	A = makeAArrayExpr(C, @B, @D);
}
array_expr(A) ::= LBRACKET(B) array_expr_list(C) RBRACKET(D). {

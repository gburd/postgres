}
/* ----- createCastStmt ----- */
createCastStmt(A) ::= CREATE CAST LPAREN typename(E) AS typename(G) RPAREN WITH FUNCTION function_with_argtypes(K) cast_context(L). {
	CreateCastStmt *n = makeNode(CreateCastStmt);
	
						n->sourcetype = E;
						n->targettype = G;
						n->func = K;
						n->context = (CoercionContext) L;
						n->inout = false;
						A = (Node *) n;
}
createCastStmt(A) ::= CREATE CAST LPAREN typename(E) AS typename(G) RPAREN WITHOUT FUNCTION cast_context(K). {
	CreateCastStmt *n = makeNode(CreateCastStmt);
	
						n->sourcetype = E;
						n->targettype = G;
						n->func = NULL;
						n->context = (CoercionContext) K;
						n->inout = false;
						A = (Node *) n;
}
createCastStmt(A) ::= CREATE CAST LPAREN typename(E) AS typename(G) RPAREN WITH INOUT cast_context(K). {
	CreateCastStmt *n = makeNode(CreateCastStmt);
	
						n->sourcetype = E;
						n->targettype = G;
						n->func = NULL;
						n->context = (CoercionContext) K;
						n->inout = true;
						A = (Node *) n;
}
/* ----- cast_context ----- */
cast_context(A) ::= AS IMPLICIT_P. {
	A = COERCION_IMPLICIT;
}
cast_context(A) ::= AS ASSIGNMENT. {
	A = COERCION_ASSIGNMENT;
}
cast_context(A) ::=. {
	A = COERCION_EXPLICIT;
}
/* ----- dropCastStmt ----- */
dropCastStmt(A) ::= DROP CAST opt_if_exists(D) LPAREN typename(F) AS typename(H) RPAREN opt_drop_behavior(J). {
	DropStmt *n = makeNode(DropStmt);
	
						n->removeType = OBJECT_CAST;
						n->objects = list_make1(list_make2(F, H));
						n->behavior = J;
						n->missing_ok = D;
						n->concurrent = false;
						A = (Node *) n;
}

/* ----- overlay_list ----- */
overlay_list(A) ::= a_expr(B) PLACING a_expr(D) FROM a_expr(F) FOR a_expr(H). {
	A = list_make4(B, D, F, H);
}
overlay_list(A) ::= a_expr(B) PLACING a_expr(D) FROM a_expr(F). {
	A = list_make3(B, D, F);
}

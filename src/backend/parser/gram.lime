}
/* ----- case_expr ----- */
case_expr(A) ::= CASE(B) case_arg(C) when_clause_list(D) case_default(E) END_P. {
	CaseExpr   *c = makeNode(CaseExpr);
	
						c->casetype = InvalidOid; 
						c->arg = (Expr *) C;
						c->args = D;
						c->defresult = (Expr *) E;
						c->location = @B;
						A = (Node *) c;
}

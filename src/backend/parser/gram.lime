}
/* ----- json_table_plan_outer ----- */
json_table_plan_outer(A) ::= json_table_plan_simple(B) OUTER_P json_table_plan_primary(D). {
	A = makeJsonTableJoinedPlan(JSTP_JOIN_OUTER, B, D, @B);
}
/* ----- json_table_plan_inner ----- */
json_table_plan_inner(A) ::= json_table_plan_simple(B) INNER_P json_table_plan_primary(D). {

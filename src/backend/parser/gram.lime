/* ----- dropdbStmt ----- */
dropdbStmt(A) ::= DROP DATABASE name(D). {
	DropdbStmt *n = makeNode(DropdbStmt);
	
						n->dbname = D;
						n->missing_ok = false;
						n->options = NULL;
						A = (Node *) n;
}
dropdbStmt(A) ::= DROP DATABASE IF_P EXISTS name(F). {

}
b_expr(A) ::= qual_Op(B) b_expr(C). [OP] {
	A = (Node *) makeA_Expr(AEXPR_OP, B, NULL, C, @B);
}
b_expr(A) ::= b_expr(B) IS(C) DISTINCT FROM b_expr(F). [IS] {
	A = (Node *) makeSimpleA_Expr(AEXPR_DISTINCT, "=", B, F, @C);
}
b_expr(A) ::= b_expr(B) IS(C) NOT DISTINCT FROM b_expr(G). [IS] {

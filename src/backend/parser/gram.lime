						n->portalname = D;
						n->direction = FETCH_BACKWARD;
						n->howMany = 1;
						n->location = -1;
						n->direction_keyword = FETCH_KEYWORD_PRIOR;
						A = (Node *) n;
}
fetch_args(A) ::= FIRST_P opt_from_in cursor_name(D). {
	FetchStmt *n = makeNode(FetchStmt);
	
						n->portalname = D;
						n->direction = FETCH_ABSOLUTE;
						n->howMany = 1;
						n->location = -1;
						n->direction_keyword = FETCH_KEYWORD_FIRST;
						A = (Node *) n;
}
fetch_args(A) ::= LAST_P opt_from_in cursor_name(D). {
	FetchStmt *n = makeNode(FetchStmt);
	
						n->portalname = D;
						n->direction = FETCH_ABSOLUTE;
						n->howMany = -1;
						n->location = -1;
						n->direction_keyword = FETCH_KEYWORD_LAST;
						A = (Node *) n;
}

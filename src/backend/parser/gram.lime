	A = B;
}
object_type_name(A) ::= DATABASE. {
	A = OBJECT_DATABASE;
}
object_type_name(A) ::= ROLE. {
	A = OBJECT_ROLE;
}
object_type_name(A) ::= SUBSCRIPTION. {
	A = OBJECT_SUBSCRIPTION;
}
object_type_name(A) ::= TABLESPACE. {

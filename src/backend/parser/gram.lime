json_predicate_type_constraint(A) ::= JSON. [UNBOUNDED] {
	A = JS_TYPE_ANY;
}
json_predicate_type_constraint(A) ::= JSON VALUE_P. {
	A = JS_TYPE_ANY;
}
json_predicate_type_constraint(A) ::= JSON ARRAY. {

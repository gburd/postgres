}
b_expr(A) ::= b_expr(B) EQ(C) b_expr(D). {
	A = (Node *) makeSimpleA_Expr(AEXPR_OP, "=", B, D, @C);
}
b_expr(A) ::= b_expr(B) LESS_EQUALS(C) b_expr(D). {
	A = (Node *) makeSimpleA_Expr(AEXPR_OP, "<=", B, D, @C);
}
b_expr(A) ::= b_expr(B) GREATER_EQUALS(C) b_expr(D). {
	A = (Node *) makeSimpleA_Expr(AEXPR_OP, ">=", B, D, @C);
}
b_expr(A) ::= b_expr(B) NOT_EQUALS(C) b_expr(D). {
	A = (Node *) makeSimpleA_Expr(AEXPR_OP, "<>", B, D, @C);
}
b_expr(A) ::= RIGHT_ARROW(B) b_expr(C). {
	A = (Node *) makeSimpleA_Expr(AEXPR_OP, "->", NULL, C, @B);
}
b_expr(A) ::= PIPE(B) b_expr(C). {
	A = (Node *) makeSimpleA_Expr(AEXPR_OP, "|", NULL, C, @B);
}

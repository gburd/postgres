#-------------------------------------------------------------------------
#
# Makefile for the bootstrap module
#
# src/backend/bootstrap/Makefile
#
#-------------------------------------------------------------------------

subdir = src/backend/bootstrap
top_builddir = ../../..
include $(top_builddir)/src/Makefile.global

override CPPFLAGS := -I. -I$(srcdir) $(CPPFLAGS)

OBJS = \
	bootparse.o \
	bootscanner.o \
	bootstrap.o

include $(top_srcdir)/src/backend/common.mk

# bootparse is now generated by Lime (see src/tools/pglime).  The .h rides
# along with the .c via Lime's -d output directory, so the header just
# depends on the .c.
bootparse.h: bootparse.c ;

bootparse.c: bootparse.lime
	lime -d. $<

# Force these dependencies to be known even without dependency info built:
bootparse.o bootscanner.o: bootparse.h boot_gram_yytype.h

clean:
	rm -f bootparse.c \
	      bootparse.h \
	      bootparse.out

      "required": false,
      "build_time_minutes": 30,
      "note": "Required for building from git checkout"
    },

    "python": {
      "version": "3.12.2",
      "url": "https://www.python.org/ftp/python/3.12.2/Python-3.12.2.tgz",
      "sha256": "be28112dac813d2053545c14bf13a16401a21877f1a69eb6ea5d84c4a0f3d870",

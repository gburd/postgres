# Inherit shared CFLAGS from ~/ws/postgres/.envrc, load this worktree's
# flake, then layer the postgres agent context (helpers need flake's PATH +
# write into this worktree's dir).
source_up
watch_file flake.nix
use flake
pg_cflags
use project_steering postgresql aws c
use git_policy allow-force-push
use project_mcp postgresq

# Inherit shared CFLAGS from ~/ws/postgres/.envrc, load this worktree's
# flake, then layer the postgres agent context (helpers need flake's PATH +
# write into this worktree's dir).
source_up
# nix-direnv watches flake.nix and flake.lock, not the shell.nix they import.
watch_file flake.nix shell.nix
use flake
use project_steering c aws
use project_steering postgresql
use project_mcp postgresq zvec-grep

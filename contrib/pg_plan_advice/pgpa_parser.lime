%name pgpa_yy
%token_type {YYSTYPE}
%extra_argument {struct GramParseExtra *extra}
%start_symbol parse_toplevel
%expect 0
%first_token 257

/* Epilogue from gram.y. */
%include {
/* ---- BEGIN gram.y prologue ---- */

/*
 * Parser for plan advice
 *
 * Copyright (c) 2000-2026, PostgreSQL Global Development Group
 *
 * contrib/pg_plan_advice/pgpa_parser.y

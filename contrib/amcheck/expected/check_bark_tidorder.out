 SELECT a, b FROM bark_sk WHERE a BETWEEN 3 AND 20 AND b > 100 ORDER BY a DESC, b DESC  | Forward ok
 SELECT a, b FROM bark_sk WHERE a = 7 AND b BETWEEN 200 AND 700 ORDER BY a, b           | no index scan ok
 SELECT a, b FROM bark_sk WHERE a = 7 AND b BETWEEN 200 AND 700 ORDER BY a DESC, b DESC | no index scan ok
 SELECT a, b FROM bark_sk WHERE a > 25 AND b < 900::int8 ORDER BY a, b                  | Backward ok
 SELECT a, b FROM bark_sk WHERE a <= 4 AND b IS NOT NULL ORDER BY a DESC, b DESC        | Forward ok
 SELECT a, b FROM bark_sk WHERE a >= 0 AND b IS NULL ORDER BY a, b                      | Backward ok
 SELECT a, b FROM bark_sk WHERE a IS NULL AND b > 500 ORDER BY a, b                     | Backward ok
 SELECT a, b FROM bark_sk WHERE a IS NOT NULL AND b >= 990 ORDER BY a, b                | Backward ok
 SELECT a, b FROM bark_sk WHERE a = ANY ('{2, 9, 10}') AND b > 500 ORDER BY a, b        | Backward ok
